<div class="py-16 px-4 bg-gradient-to-r from-deep-maroon via-charcoal-black to-gold text-white relative overflow-hidden">
  <!-- Cultural Pattern Background -->
  <div class="absolute inset-0 opacity-5">
    <div class="h-full w-full bg-repeat" style="background-image: url('data:image/svg+xml,%3Csvg width=\\'60\\' height=\\'60\\' viewBox=\\'0 0 60 60\\' xmlns=\\'http://www.w3.org/2000/svg\\'%3E%3Cg fill=\\'%23D4AF37\\'%3E%3Cpath d=\\'M30 30c0-11.046-8.954-20-20-20s-20 8.954-20 20 8.954 20 20 20 20-8.954 20-20z\\'/%3E%3C/g%3E%3C/svg%3E');"></div>
  </div>

  <div class="container mx-auto relative z-10">
    <div class="max-w-4xl mx-auto text-center">
      <!-- Section Title -->
      <div class="mb-8">
        <h2 class="text-4xl md:text-5xl font-bold mb-4">
          {% render 'translation', key: 'newsletter.enhanced_title', default: 'Join the Tamil Fashion Community' %}
        </h2>
        <p class="text-xl text-gold font-tamil mb-4">
          {% render 'translation', key: 'newsletter.enhanced_subtitle_tamil', default: 'ரவன் ஃபேஷன் சமூகத்தில் இணையுங்கள்' %}
        </p>
        <p class="text-lg text-gray-300 max-w-2xl mx-auto">
          {% render 'translation', key: 'newsletter.enhanced_description', default: 'Get exclusive access to new collections, cultural events, and special offers celebrating Tamil heritage.' %}
        </p>
      </div>

      <!-- Benefits Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
        <div class="benefit-item text-center">
          <div class="w-16 h-16 bg-gold bg-opacity-20 rounded-full mx-auto mb-4 flex items-center justify-center">
            <svg class="w-8 h-8 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-2">
            {% render 'translation', key: 'newsletter.benefit_1', default: 'Exclusive Offers' %}
          </h3>
          <p class="text-gray-300 text-sm">
            {% render 'translation', key: 'newsletter.benefit_1_desc', default: 'Special discounts for community members' %}
          </p>
        </div>

        <div class="benefit-item text-center">
          <div class="w-16 h-16 bg-gold bg-opacity-20 rounded-full mx-auto mb-4 flex items-center justify-center">
            <svg class="w-8 h-8 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-2">
            {% render 'translation', key: 'newsletter.benefit_2', default: 'Early Access' %}
          </h3>
          <p class="text-gray-300 text-sm">
            {% render 'translation', key: 'newsletter.benefit_2_desc', default: 'Be first to shop new collections' %}
          </p>
        </div>

        <div class="benefit-item text-center">
          <div class="w-16 h-16 bg-gold bg-opacity-20 rounded-full mx-auto mb-4 flex items-center justify-center">
            <svg class="w-8 h-8 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-2">
            {% render 'translation', key: 'newsletter.benefit_3', default: 'Cultural Stories' %}
          </h3>
          <p class="text-gray-300 text-sm">
            {% render 'translation', key: 'newsletter.benefit_3_desc', default: 'Learn about Tamil fashion heritage' %}
          </p>
        </div>
      </div>

      <!-- Enhanced Newsletter Form -->
      <div class="max-w-md mx-auto">
        {% render 'enhanced-newsletter-form' %}
      </div>

      <!-- Trust Indicators -->
      <div class="mt-12 flex flex-wrap justify-center items-center gap-8 text-sm text-gray-400">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
          </svg>
          <span>{% render 'translation', key: 'newsletter.privacy', default: 'Privacy Protected' %}</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
          <span>{% render 'translation', key: 'newsletter.no_spam', default: 'No Spam' %}</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
          </svg>
          <span>{% render 'translation', key: 'newsletter.unsubscribe', default: 'Easy Unsubscribe' %}</span>
        </div>
      </div>

      <!-- Cultural Note -->
      <div class="mt-8 p-4 bg-white bg-opacity-10 rounded-lg">
        <p class="text-sm text-gold font-tamil">
          {% render 'translation', key: 'newsletter.cultural_note', default: 'எங்களுடன் இணைந்து தமிழ் கலாச்சாரத்தைப் பாதுகாப்போம்' %}
        </p>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Enhanced Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Join the Tamil Fashion Community"
    },
    {
      "type": "text",
      "id": "subtitle_tamil",
      "label": "Subtitle (Tamil)",
      "default": "ரவன் ஃபேஷன் சமூகத்தில் இணையுங்கள்"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Get exclusive access to new collections, cultural events, and special offers celebrating Tamil heritage."
    }
  ],
  "presets": [
    {
      "name": "Enhanced Newsletter",
      "category": "Promotional"
    }
  ]
}
{% endschema %}