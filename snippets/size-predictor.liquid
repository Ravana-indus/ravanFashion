{%- comment -%}
Size Predictor Snippet
AI-powered size recommendation system with measurements, fit analysis, and personalized suggestions
{%- endcomment -%}

<div class="size-predictor" data-section-id="{{ section.id }}" data-product-id="{{ product.id }}">
  <!-- Size Predictor Container -->
  <div class="predictor-container bg-white rounded-lg shadow-lg overflow-hidden">

    <!-- Header -->
    <div class="predictor-header bg-gradient-to-r from-purple-600 to-blue-600 text-white p-6">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-2xl font-bold mb-2">{{ 'products.size_predictor.ai_size_recommendation' | t }}</h2>
        <p class="text-purple-100">{{ 'products.size_predictor.perfect_fit_guaranteed' | t }}</p>
        <div class="mt-4 flex justify-center gap-4 text-sm">
          <div class="flex items-center gap-1">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"/>
            </svg>
            {{ 'products.size_predictor.ml_algorithm' | t }}
          </div>
          <div class="flex items-center gap-1">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"/>
            </svg>
            {{ 'products.size_predictor.body_analysis' | t }}
          </div>
          <div class="flex items-center gap-1">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"/>
            </svg>
            {{ 'products.size_predictor.style_matching' | t }}
          </div>
        </div>
      </div>
    </div>

    <div class="max-w-4xl mx-auto p-6">
      <!-- Step Progress Indicator -->
      <div class="step-progress mb-8">
        <div class="flex items-center justify-between">
          <div class="step flex-1 text-center" data-step="1">
            <div class="step-circle w-8 h-8 bg-purple-600 text-white rounded-full flex items-center justify-center mx-auto mb-2 text-sm font-medium">1</div>
            <div class="step-label text-sm font-medium text-gray-700">{{ 'products.size_predictor.measurements' | t }}</div>
          </div>
          <div class="step-connector flex-1 h-1 bg-gray-300 mx-2"></div>
          <div class="step flex-1 text-center" data-step="2">
            <div class="step-circle w-8 h-8 bg-gray-300 text-gray-600 rounded-full flex items-center justify-center mx-auto mb-2 text-sm font-medium">2</div>
            <div class="step-label text-sm font-medium text-gray-500">{{ 'products.size_predictor.preferences' | t }}</div>
          </div>
          <div class="step-connector flex-1 h-1 bg-gray-300 mx-2"></div>
          <div class="step flex-1 text-center" data-step="3">
            <div class="step-circle w-8 h-8 bg-gray-300 text-gray-600 rounded-full flex items-center justify-center mx-auto mb-2 text-sm font-medium">3</div>
            <div class="step-label text-sm font-medium text-gray-500">{{ 'products.size_predictor.recommendations' | t }}</div>
          </div>
        </div>
      </div>

      <!-- Step 1: Measurements -->
      <div class="step-content active" data-step-content="1">
        <div class="bg-blue-50 rounded-lg p-6 mb-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M3 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z"/>
            </svg>
            {{ 'products.size_predictor.enter_measurements' | t }}
          </h3>
          <p class="text-sm text-gray-600 mb-4">{{ 'products.size_predictor.measurement_instructions' | t }}</p>

          <!-- Gender Selection -->
          <div class="mb-6">
            <label class="block text-sm font-medium text-gray-700 mb-2">{{ 'products.size_predictor.gender' | t }}</label>
            <div class="gender-options flex gap-4">
              <button class="gender-option flex-1 p-4 border-2 border-gray-200 rounded-lg hover:border-purple-400 transition-all text-center" data-gender="female">
                <svg class="w-8 h-8 mx-auto mb-2 text-pink-500" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z"/>
                </svg>
                <div class="font-medium">{{ 'products.size_predictor.women' | t }}</div>
              </button>
              <button class="gender-option flex-1 p-4 border-2 border-gray-200 rounded-lg hover:border-purple-400 transition-all text-center" data-gender="male">
                <svg class="w-8 h-8 mx-auto mb-2 text-blue-500" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z"/>
                </svg>
                <div class="font-medium">{{ 'products.size_predictor.men' | t }}</div>
              </button>
              <button class="gender-option flex-1 p-4 border-2 border-gray-200 rounded-lg hover:border-purple-400 transition-all text-center" data-gender="unisex">
                <svg class="w-8 h-8 mx-auto mb-2 text-purple-500" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M10 12a2 2 0 100-4 2 2 0 000 4z"/>
                  <path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z"/>
                </svg>
                <div class="font-medium">{{ 'products.size_predictor.unisex' | t }}</div>
              </button>
            </div>
          </div>

          <!-- Measurement Input -->
          <div class="measurements-grid grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Height -->
            <div class="measurement-group">
              <label class="block text-sm font-medium text-gray-700 mb-2">
                {{ 'products.size_predictor.height' | t }}
                <span class="text-gray-500">({{ 'products.size_predictor.cm' | t }})</span>
              </label>
              <input type="number" id="height" class="measurement-input w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-400 focus:border-transparent" placeholder="165" min="120" max="220">
              <div class="measurement-guide mt-2 text-xs text-gray-500">
                <svg class="w-4 h-4 inline-block mr-1" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z"/>
                </svg>
                {{ 'products.size_predictor.height_guide' | t }}
              </div>
            </div>

            <!-- Weight -->
            <div class="measurement-group">
              <label class="block text-sm font-medium text-gray-700 mb-2">
                {{ 'products.size_predictor.weight' | t }}
                <span class="text-gray-500">({{ 'products.size_predictor.kg' | t }})</span>
              </label>
              <input type="number" id="weight" class="measurement-input w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-400 focus:border-transparent" placeholder="65" min="30" max="200">
              <div class="measurement-guide mt-2 text-xs text-gray-500">
                <svg class="w-4 h-4 inline-block mr-1" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z"/>
                </svg>
                {{ 'products.size_predictor.weight_guide' | t }}
              </div>
            </div>

            <!-- Chest/Bust -->
            <div class="measurement-group">
              <label class="block text-sm font-medium text-gray-700 mb-2">
                <span class="chest-label">{{ 'products.size_predictor.chest' | t }}</span>
                <span class="text-gray-500">({{ 'products.size_predictor.cm' | t }})</span>
              </label>
              <input type="number" id="chest" class="measurement-input w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-400 focus:border-transparent" placeholder="90" min="70" max="150">
              <div class="measurement-guide mt-2 text-xs text-gray-500">
                <svg class="w-4 h-4 inline-block mr-1" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z"/>
                </svg>
                <span class="chest-guide">{{ 'products.size_predictor.chest_guide' | t }}</span>
              </div>
            </div>

            <!-- Waist -->
            <div class="measurement-group">
              <label class="block text-sm font-medium text-gray-700 mb-2">
                {{ 'products.size_predictor.waist' | t }}
                <span class="text-gray-500">({{ 'products.size_predictor.cm' | t }})</span>
              </label>
              <input type="number" id="waist" class="measurement-input w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-400 focus:border-transparent" placeholder="75" min="60" max="140">
              <div class="measurement-guide mt-2 text-xs text-gray-500">
                <svg class="w-4 h-4 inline-block mr-1" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z"/>
                </svg>
                {{ 'products.size_predictor.waist_guide' | t }}
              </div>
            </div>

            <!-- Hips (for women) -->
            <div class="measurement-group hips-group" style="display: none;">
              <label class="block text-sm font-medium text-gray-700 mb-2">
                {{ 'products.size_predictor.hips' | t }}
                <span class="text-gray-500">({{ 'products.size_predictor.cm' | t }})</span>
              </label>
              <input type="number" id="hips" class="measurement-input w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-400 focus:border-transparent" placeholder="95" min="80" max="160">
              <div class="measurement-guide mt-2 text-xs text-gray-500">
                <svg class="w-4 h-4 inline-block mr-1" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z"/>
                </svg>
                {{ 'products.size_predictor.hips_guide' | t }}
              </div>
            </div>

            <!-- Body Type -->
            <div class="measurement-group">
              <label class="block text-sm font-medium text-gray-700 mb-2">{{ 'products.size_predictor.body_type' | t }}</label>
              <select id="body-type" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-400 focus:border-transparent">
                <option value="">{{ 'products.size_predictor.select_body_type' | t }}</option>
                <option value="ectomorph">{{ 'products.size_predictor.ectomorph' | t }} - {{ 'products.size_predictor.lean_slender' | t }}</option>
                <option value="mesomorph">{{ 'products.size_predictor.mesomorph' | t }} - {{ 'products.size_predictor.athletic_muscular' | t }}</option>
                <option value="endomorph">{{ 'products.size_predictor.endomorph' | t }} - {{ 'products.size_predictor.curvy_fuller' | t }}</option>
              </select>
            </div>
          </div>

          <!-- Size System -->
          <div class="mt-6">
            <label class="block text-sm font-medium text-gray-700 mb-2">{{ 'products.size_predictor.preferred_size_system' | t }}</label>
            <div class="size-system-options flex gap-4">
              <button class="size-system-option px-4 py-2 border-2 border-gray-200 rounded-lg hover:border-purple-400 transition-all" data-system="EU">{{ 'products.size_predictor.european' | t }}</button>
              <button class="size-system-option px-4 py-2 border-2 border-gray-200 rounded-lg hover:border-purple-400 transition-all" data-system="US">{{ 'products.size_predictor.us' | t }}</button>
              <button class="size-system-option px-4 py-2 border-2 border-gray-200 rounded-lg hover:border-purple-400 transition-all" data-system="UK">{{ 'products.size_predictor.uk' | t }}</button>
              <button class="size-system-option px-4 py-2 border-2 border-gray-200 rounded-lg hover:border-purple-400 transition-all active" data-system="INT">{{ 'products.size_predictor.international' | t }}</button>
            </div>
          </div>
        </div>

        <div class="flex justify-end">
          <button class="next-step-btn bg-purple-600 text-white px-6 py-2 rounded-lg hover:bg-purple-700 transition-colors" data-next-step="2">
            {{ 'products.size_predictor.next_preferences' | t }}
            <svg class="w-4 h-4 inline-block ml-1" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Step 2: Preferences -->
      <div class="step-content" data-step-content="2" style="display: none;">
        <div class="bg-purple-50 rounded-lg p-6 mb-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-purple-600" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z"/>
            </svg>
            {{ 'products.size_predictor.your_preferences' | t }}
          </h3>
          <p class="text-sm text-gray-600 mb-4">{{ 'products.size_predictor.preferences_help' | t }}</p>

          <!-- Fit Preference -->
          <div class="mb-6">
            <label class="block text-sm font-medium text-gray-700 mb-3">{{ 'products.size_predictor.preferred_fit' | t }}</label>
            <div class="fit-options grid grid-cols-2 md:grid-cols-4 gap-3">
              <button class="fit-option p-4 border-2 border-gray-200 rounded-lg hover:border-purple-400 transition-all text-center" data-fit="tight">
                <div class="fit-icon text-2xl mb-2">👗</div>
                <div class="font-medium">{{ 'products.size_predictor.tight' | t }}</div>
                <div class="text-xs text-gray-500">{{ 'products.size_predictor.snug_fit' | t }}</div>
              </button>
              <button class="fit-option p-4 border-2 border-gray-200 rounded-lg hover:border-purple-400 transition-all text-center active" data-fit="regular">
                <div class="fit-icon text-2xl mb-2">👔</div>
                <div class="font-medium">{{ 'products.size_predictor.regular' | t }}</div>
                <div class="text-xs text-gray-500">{{ 'products.size_predictor.standard_fit' | t }}</div>
              </button>
              <button class="fit-option p-4 border-2 border-gray-200 rounded-lg hover:border-purple-400 transition-all text-center" data-fit="loose">
                <div class="fit-icon text-2xl mb-2">👕</div>
                <div class="font-medium">{{ 'products.size_predictor.loose' | t }}</div>
                <div class="text-xs text-gray-500">{{ 'products.size_predictor.relaxed_fit' | t }}</div>
              </button>
              <button class="fit-option p-4 border-2 border-gray-200 rounded-lg hover:border-purple-400 transition-all text-center" data-fit="oversized">
                <div class="fit-icon text-2xl mb-2">🧥</div>
                <div class="font-medium">{{ 'products.size_predictor.oversized' | t }}</div>
                <div class="text-xs text-gray-500">{{ 'products.size_predictor.extra_room' | t }}</div>
              </button>
            </div>
          </div>

          <!-- Comfort Priority -->
          <div class="mb-6">
            <label class="block text-sm font-medium text-gray-700 mb-3">{{ 'products.size_predictor.comfort_priority' | t }}</label>
            <div class="comfort-options space-y-3">
              <div class="flex items-center justify-between p-3 border border-gray-200 rounded-lg hover:border-purple-400 transition-all">
                <div>
                  <div class="font-medium">{{ 'products.size_predictor.breathability' | t }}</div>
                  <div class="text-sm text-gray-500">{{ 'products.size_predictor.air_circulation' | t }}</div>
                </div>
                <input type="range" class="comfort-slider w-24" data-comfort="breathability" min="1" max="5" value="3">
              </div>
              <div class="flex items-center justify-between p-3 border border-gray-200 rounded-lg hover:border-purple-400 transition-all">
                <div>
                  <div class="font-medium">{{ 'products.size_predictor.freedom_movement' | t }}</div>
                  <div class="text-sm text-gray-500">{{ 'products.size_predictor.range_motion' | t }}</div>
                </div>
                <input type="range" class="comfort-slider w-24" data-comfort="movement" min="1" max="5" value="3">
              </div>
              <div class="flex items-center justify-between p-3 border border-gray-200 rounded-lg hover:border-purple-400 transition-all">
                <div>
                  <div class="font-medium">{{ 'products.size_predictor.style_appearance' | t }}</div>
                  <div class="text-sm text-gray-500">{{ 'products.size_predictor.look_fit' | t }}</div>
                </div>
                <input type="range" class="comfort-slider w-24" data-comfort="style" min="1" max="5" value="3">
              </div>
            </div>
          </div>

          <!-- Typical Issues -->
          <div class="mb-6">
            <label class="block text-sm font-medium text-gray-700 mb-3">{{ 'products.size_predictor.common_issues' | t }}</label>
            <div class="issues-grid grid grid-cols-1 md:grid-cols-2 gap-3">
              <label class="issue-option flex items-center p-3 border border-gray-200 rounded-lg hover:border-purple-400 transition-all cursor-pointer">
                <input type="checkbox" class="issue-checkbox mr-3" data-issue="shoulders-tight">
                <span>{{ 'products.size_predictor.shoulders_tight' | t }}</span>
              </label>
              <label class="issue-option flex items-center p-3 border border-gray-200 rounded-lg hover:border-purple-400 transition-all cursor-pointer">
                <input type="checkbox" class="issue-checkbox mr-3" data-issue="sleeves-long">
                <span>{{ 'products.size_predictor.sleeves_long' | t }}</span>
              </label>
              <label class="issue-option flex items-center p-3 border border-gray-200 rounded-lg hover:border-purple-400 transition-all cursor-pointer">
                <input type="checkbox" class="issue-checkbox mr-3" data-issue="waist-loose">
                <span>{{ 'products.size_predictor.waist_loose' | t }}</span>
              </label>
              <label class="issue-option flex items-center p-3 border border-gray-200 rounded-lg hover:border-purple-400 transition-all cursor-pointer">
                <input type="checkbox" class="issue-checkbox mr-3" data-issue="length-short">
                <span>{{ 'products.size_predictor.length_short' | t }}</span>
              </label>
              <label class="issue-option flex items-center p-3 border border-gray-200 rounded-lg hover:border-purple-400 transition-all cursor-pointer">
                <input type="checkbox" class="issue-checkbox mr-3" data-issue="chest-tight">
                <span>{{ 'products.size_predictor.chest_tight' | t }}</span>
              </label>
              <label class="issue-option flex items-center p-3 border border-gray-200 rounded-lg hover:border-purple-400 transition-all cursor-pointer">
                <input type="checkbox" class="issue-checkbox mr-3" data-issue="hips-tight">
                <span>{{ 'products.size_predictor.hips_tight' | t }}</span>
              </label>
            </div>
          </div>

          <!-- Fabric Preference -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-3">{{ 'products.size_predictor.fabric_preference' | t }}</label>
            <div class="fabric-options grid grid-cols-2 md:grid-cols-4 gap-3">
              <button class="fabric-option p-3 border-2 border-gray-200 rounded-lg hover:border-purple-400 transition-all text-center active" data-fabric="stretch">
                <div class="text-2xl mb-1">🧵</div>
                <div class="text-sm">{{ 'products.size_predictor.stretch' | t }}</div>
              </button>
              <button class="fabric-option p-3 border-2 border-gray-200 rounded-lg hover:border-purple-400 transition-all text-center" data-fabric="structured">
                <div class="text-2xl mb-1">👔</div>
                <div class="text-sm">{{ 'products.size_predictor.structured' | t }}</div>
              </button>
              <button class="fabric-option p-3 border-2 border-gray-200 rounded-lg hover:border-purple-400 transition-all text-center" data-fabric="flowing">
                <div class="text-2xl mb-1">👗</div>
                <div class="text-sm">{{ 'products.size_predictor.flowing' | t }}</div>
              </button>
              <button class="fabric-option p-3 border-2 border-gray-200 rounded-lg hover:border-purple-400 transition-all text-center" data-fabric="heavy">
                <div class="text-2xl mb-1">🧥</div>
                <div class="text-sm">{{ 'products.size_predictor.heavy' | t }}</div>
              </button>
            </div>
          </div>
        </div>

        <div class="flex justify-between">
          <button class="prev-step-btn bg-gray-200 text-gray-700 px-6 py-2 rounded-lg hover:bg-gray-300 transition-colors" data-prev-step="1">
            <svg class="w-4 h-4 inline-block mr-1" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z"/>
            </svg>
            {{ 'products.size_predictor.back_measurements' | t }}
          </button>
          <button class="next-step-btn bg-purple-600 text-white px-6 py-2 rounded-lg hover:bg-purple-700 transition-colors" data-next-step="3">
            {{ 'products.size_predictor.get_recommendations' | t }}
            <svg class="w-4 h-4 inline-block ml-1" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Step 3: Recommendations -->
      <div class="step-content" data-step-content="3" style="display: none;">
        <div class="recommendations-container">
