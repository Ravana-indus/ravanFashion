<script>
// Size Predictor JavaScript
document.addEventListener('DOMContentLoaded', function() {
  class SizePredictor {
    constructor(container) {
      this.container = container;
      this.currentStep = 1;
      this.measurements = {
        gender: '',
        height: null,
        weight: null,
        chest: null,
        waist: null,
        hips: null,
        bodyType: '',
        sizeSystem: 'INT'
      };
      this.preferences = {
        fit: 'regular',
        comfort: {
          breathability: 3,
          movement: 3,
          style: 3
        },
        issues: [],
        fabric: 'stretch'
      };
      this.recommendation = null;

      this.init();
    }

    init() {
      this.setupEventListeners();
      this.loadSavedMeasurements();
    }

    setupEventListeners() {
      // Gender selection
      this.container.querySelectorAll('.gender-option').forEach(btn => {
        btn.addEventListener('click', () => {
          this.selectGender(btn.dataset.gender);
        });
      });

      // Measurement inputs
      this.container.querySelectorAll('.measurement-input').forEach(input => {
        input.addEventListener('input', (e) => {
          this.updateMeasurement(input.id, parseFloat(e.target.value));
        });
      });

      // Body type selection
      this.container.querySelector('#body-type').addEventListener('change', (e) => {
        this.measurements.bodyType = e.target.value;
      });

      // Size system selection
      this.container.querySelectorAll('.size-system-option').forEach(btn => {
        btn.addEventListener('click', () => {
          this.selectSizeSystem(btn.dataset.system);
        });
      });

      // Fit preference
      this.container.querySelectorAll('.fit-option').forEach(btn => {
        btn.addEventListener('click', () => {
          this.selectFit(btn.dataset.fit);
        });
      });

      // Comfort sliders
      this.container.querySelectorAll('.comfort-slider').forEach(slider => {
        slider.addEventListener('input', (e) => {
          this.updateComfort(slider.dataset.comfort, parseInt(e.target.value));
        });
      });

      // Issue checkboxes
      this.container.querySelectorAll('.issue-checkbox').forEach(checkbox => {
        checkbox.addEventListener('change', (e) => {
          this.updateIssue(e.target.dataset.issue, e.target.checked);
        });
      });

      // Fabric preference
      this.container.querySelectorAll('.fabric-option').forEach(btn => {
        btn.addEventListener('click', () => {
          this.selectFabric(btn.dataset.fabric);
        });
      });

      // Step navigation
      this.container.querySelectorAll('.next-step-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          this.nextStep(parseInt(btn.dataset.nextStep));
        });
      });

      this.container.querySelectorAll('.prev-step-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          this.prevStep(parseInt(btn.dataset.prevStep));
        });
      });

      // Action buttons
      this.container.querySelector('.restart-btn')?.addEventListener('click', () => {
        this.restart();
      });

      this.container.querySelector('.save-measurements-btn')?.addEventListener('click', () => {
        this.saveMeasurements();
      });

      this.container.querySelector('.share-results-btn')?.addEventListener('click', () => {
        this.shareResults();
      });

      this.container.querySelectorAll('.add-to-cart-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          this.addToCart(btn.dataset.size);
        });
      });

      this.container.querySelectorAll('.select-size-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          this.addToCart(btn.closest('.size-option-card').querySelector('.size-label').textContent);
        });
      });
    }

    selectGender(gender) {
      this.measurements.gender = gender;
      this.updateActiveState('.gender-option', this.container.querySelector(`[data-gender="${gender}"]`));

      // Show/hide hips measurement based on gender
      const hipsGroup = this.container.querySelector('.hips-group');
      if (gender === 'female') {
        hipsGroup.style.display = 'block';
      } else {
        hipsGroup.style.display = 'none';
      }

      // Update measurement labels
      this.updateMeasurementLabels(gender);
    }

    updateMeasurementLabels(gender) {
      const chestLabel = this.container.querySelector('.chest-label');
      const chestGuide = this.container.querySelector('.chest-guide');

      if (gender === 'female') {
        chestLabel.textContent = '{{ 'products.size_predictor.bust' | t }}';
        chestGuide.textContent = '{{ 'products.size_predictor.bust_guide' | t }}';
      } else {
        chestLabel.textContent = '{{ 'products.size_predictor.chest' | t }}';
        chestGuide.textContent = '{{ 'products.size_predictor.chest_guide' | t }}';
      }
    }

    updateMeasurement(type, value) {
      this.measurements[type] = value;
    }

    selectSizeSystem(system) {
      this.measurements.sizeSystem = system;
      this.updateActiveState('.size-system-option', this.container.querySelector(`[data-system="${system}"]`));
    }

    selectFit(fit) {
      this.preferences.fit = fit;
      this.updateActiveState('.fit-option', this.container.querySelector(`[data-fit="${fit}"]`));
    }

    updateComfort(type, value) {
      this.preferences.comfort[type] = value;
    }

    updateIssue(issue, checked) {
      if (checked) {
        this.preferences.issues.push(issue);
      } else {
        this.preferences.issues = this.preferences.issues.filter(i => i !== issue);
      }
    }

    selectFabric(fabric) {
      this.preferences.fabric = fabric;
      this.updateActiveState('.fabric-option', this.container.querySelector(`[data-fabric="${fabric}"]`));
    }

    updateActiveState(selector, activeElement) {
      this.container.querySelectorAll(selector).forEach(el => {
        el.classList.remove('active');
      });
      activeElement.classList.add('active');
    }

    nextStep(step) {
      if (this.validateCurrentStep()) {
        this.currentStep = step;
        this.updateStepDisplay();
        this.updateStepProgress();

        if (step === 3) {
          this.generateRecommendations();
        }
      }
    }

    prevStep(step) {
      this.currentStep = step;
      this.updateStepDisplay();
      this.updateStepProgress();
    }

    validateCurrentStep() {
      switch(this.currentStep) {
        case 1:
          if (!this.measurements.gender) {
            this.showNotification('{{ 'products.size_predictor.select_gender' | t }}', 'error');
            return false;
          }
          if (!this.measurements.height || !this.measurements.weight || !this.measurements.chest || !this.measurements.waist) {
            this.showNotification('{{ 'products.size_predictor.fill_required_measurements' | t }}', 'error');
            return false;
          }
          if (this.measurements.gender === 'female' && !this.measurements.hips) {
            this.showNotification('{{ 'products.size_predictor.hips_measurement_required' | t }}', 'error');
            return false;
          }
          return true;
        case 2:
          return true; // Preferences are optional
        default:
          return true;
      }
    }

    updateStepDisplay() {
      // Hide all step contents
      this.container.querySelectorAll('.step-content').forEach(content => {
        content.style.display = 'none';
      });

      // Show current step content
      const currentContent = this.container.querySelector(`[data-step-content="${this.currentStep}"]`);
      if (currentContent) {
        currentContent.style.display = 'block';
      }
    }

    updateStepProgress() {
      // Update step circles
      this.container.querySelectorAll('.step').forEach((step, index) => {
        const stepNumber = index + 1;
        const circle = step.querySelector('.step-circle');
        const label = step.querySelector('.step-label');

        if (stepNumber < this.currentStep) {
          circle.classList.add('active');
          label.classList.add('active');
        } else if (stepNumber === this.currentStep) {
          circle.classList.add('active');
          label.classList.add('active');
        } else {
          circle.classList.remove('active');
          label.classList.remove('active');
        }
      });
    }

    async generateRecommendations() {
      // Show AI processing
      this.showAIProcessing();

      // Simulate AI processing with realistic delays
      await this.simulateAIProcessing();

      // Generate recommendation
      this.recommendation = this.calculateRecommendation();

      // Display results
      this.displayResults();
    }

    showAIProcessing() {
      const processing = this.container.querySelector('#ai-processing');
      const results = this.container.querySelector('#results-content');

      processing.style.display = 'block';
      results.classList.add('hidden');
    }

    async simulateAIProcessing() {
      const steps = [
        { element: '.processing-step:nth-child(1)', duration: 1000 },
        { element: '.processing-step:nth-child(2)', duration: 800 },
        { element: '.processing-step:nth-child(3)', duration: 1200 },
        { element: '.processing-step:nth-child(4)', duration: 600 }
      ];

      for (const step of steps) {
        await new Promise(resolve => {
          setTimeout(() => {
            const stepElement = this.container.querySelector(step.element);
            const dot = stepElement.querySelector('.step-dot');
            dot.classList.add('active');
            resolve();
          }, step.duration);
        });
      }

      // Final delay before showing results
      await new Promise(resolve => setTimeout(resolve, 500));
    }

    calculateRecommendation() {
      // Calculate body mass index
      const heightInM = this.measurements.height / 100;
      const bmi = this.measurements.weight / (heightInM * heightInM);

      // Calculate size based on chest measurement (primary factor)
      let size = this.calculateSizeFromMeasurements();

      // Adjust based on preferences
      size = this.adjustSizeForPreferences(size);

      // Calculate confidence score
      const confidence = this.calculateConfidenceScore();

      // Generate explanation
      const explanation = this.generateExplanation(size, confidence);

      return {
        size: size,
        confidence: confidence,
        explanation: explanation,
        bmi: bmi,
        alternativeSizes: this.getAlternativeSizes(size)
      };
    }

    calculateSizeFromMeasurements() {
      const { chest, waist, hips, gender } = this.measurements;

      // Size calculation based on gender and measurements
      if (gender === 'female') {
        // Women's sizing based on bust measurement
        if (chest < 84) return 'XS';
        if (chest < 88) return 'S';
        if (chest < 92) return 'M';
        if (chest < 96) return 'L';
        if (chest < 100) return 'XL';
        return 'XXL';
      } else {
        // Men's sizing based on chest measurement
        if (chest < 88) return 'XS';
        if (chest < 92) return 'S';
        if (chest < 96) return 'M';
        if (chest < 100) return 'L';
        if (chest < 104) return 'XL';
        return 'XXL';
      }
    }

    adjustSizeForPreferences(size) {
      const sizeOrder = ['XS', 'S', 'M', 'L', 'XL', 'XXL'];
      let currentIndex = sizeOrder.indexOf(size);

      // Adjust based on fit preference
      switch(this.preferences.fit) {
        case 'tight':
          currentIndex = Math.max(0, currentIndex - 1);
          break;
        case 'loose':
        case 'oversized':
          currentIndex = Math.min(sizeOrder.length - 1, currentIndex + 1);
          break;
      }

      // Adjust based on body type
      if (this.measurements.bodyType === 'endomorph' && this.preferences.fit === 'regular') {
        currentIndex = Math.min(sizeOrder.length - 1, currentIndex + 1);
      }

      return sizeOrder[currentIndex];
    }

    calculateConfidenceScore() {
      let score = 100;

      // Deduct for missing measurements
      if (!this.measurements.hips && this.measurements.gender === 'female') score -= 10;
      if (!this.measurements.bodyType) score -= 5;

      // Deduct for conflicting preferences
      if (this.preferences.issues.length > 2) score -= 10;

      // Boost for complete measurements
      if (this.measurements.height && this.measurements.weight && this.measurements.chest && this.measurements.waist) {
        score += 5;
      }

      return Math.max(60, Math.min(100, score));
    }

    generateExplanation(size, confidence) {
      const explanations = {
        'XS': '{{ 'products.size_predictor.size_xs_explanation' | t }}',
        'S': '{{ 'products.size_predictor.size_s_explanation' | t }}',
        'M': '{{ 'products.size_predictor.size_m_explanation' | t }}',
        'L': '{{ 'products.size_predictor.size_l_explanation' | t }}',
        'XL': '{{ 'products.size_predictor.size_xl_explanation' | t }}',
        'XXL': '{{ 'products.size_predictor.size_xxl_explanation' | t }}'
      };

      let explanation = explanations[size] || explanations['M'];

      // Add preference-based reasoning
      if (this.preferences.fit === 'tight') {
        explanation += ' {{ 'products.size_predictor.tight_fit_reason' | t }}';
      } else if (this.preferences.fit === 'loose') {
        explanation += ' {{ 'products.size_predictor.loose_fit_reason' | t }}';
      }

      return explanation;
    }

    getAlternativeSizes(size) {
      const sizeOrder = ['XS', 'S', 'M', 'L', 'XL', 'XXL'];
      const currentIndex = sizeOrder.indexOf(size);
      const alternatives = [];

      if (currentIndex > 0) alternatives.push(sizeOrder[currentIndex - 1]);
      if (currentIndex < sizeOrder.length - 1) alternatives.push(sizeOrder[currentIndex + 1]);

      return alternatives;
    }

    displayResults() {
      // Hide processing, show results
      this.container.querySelector('#ai-processing').style.display = 'none';
      this.container.querySelector('#results-content').classList.remove('hidden');

      // Update recommendation display
      const recommendation = this.recommendation;
      this.container.querySelector('#recommended-size').textContent = recommendation.size;
      this.container.querySelector('#recommendation-explanation').textContent = recommendation.explanation;

      // Update international sizes
      this.updateInternationalSizes(recommendation.size);

      // Create charts
      this.createMeasurementsChart();
      this.updateFitScores();

      // Update confidence badge
      const confidenceBadge = this.container.querySelector('.confidence-badge');
      if (recommendation.confidence >= 85) {
        confidenceBadge.textContent = '{{ 'products.size_predictor.high_confidence' | t }}';
        confidenceBadge.className = 'confidence-badge bg-green-600 text-white px-3 py-1 rounded-full text-sm font-medium';
      } else if (recommendation.confidence >= 70) {
        confidenceBadge.textContent = '{{ 'products.size_predictor.medium_confidence' | t }}';
        confidenceBadge.className = 'confidence-badge bg-yellow-600 text-white px-3 py-1 rounded-full text-sm font-medium';
      } else {
        confidenceBadge.textContent = '{{ 'products.size_predictor.low_confidence' | t }}';
        confidenceBadge.className = 'confidence-badge bg-red-600 text-white px-3 py-1 rounded-full text-sm font-medium';
      }
    }

    updateInternationalSizes(size) {
      const sizeMappings = {
        'XS': { EU: '34-36', US: '0-2', UK: '4-6' },
        'S': { EU: '36-38', US: '2-4', UK: '6-8' },
        'M': { EU: '38-40', US: '4-6', UK: '8-10' },
        'L': { EU: '40-42', US: '6-8', UK: '10-12' },
        'XL': { EU: '42-44', US: '8-10', UK: '12-14' },
        'XXL': { EU: '44-46', US: '10-12', UK: '14-16' }
      };

      const mapping = sizeMappings[this.recommendation.size] || sizeMappings['M'];
      this.container.querySelector('#eu-size').textContent = mapping.EU;
      this.container.querySelector('#us-size').textContent = mapping.US;
      this.container.querySelector('#uk-size').textContent = mapping.UK;
    }

    createMeasurementsChart() {
      const canvas = this.container.querySelector('#measurements-chart');
      const ctx = canvas.getContext('2d');

      // Clear canvas
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      // Data
      const measurements = [
        { label: '{{ 'products.size_predictor.chest' | t }}', value: this.measurements.chest, color: '#8b5cf6' },
        { label: '{{ 'products.size_predictor.waist' | t }}', value: this.measurements.waist, color: '#3b82f6' }
      ];

      if (this.measurements.hips) {
        measurements.push({ label: '{{ 'products.size_predictor.hips' | t }}', value: this.measurements.hips, color: '#10b981' });
      }

      // Draw bar chart
      const barWidth = 40;
      const barSpacing = 30;
      const maxValue = Math.max(...measurements.map(m => m.value));
      const chartHeight = 150;

      measurements.forEach((measurement, index) => {
        const x = 20 + index * (barWidth + barSpacing);
        const barHeight = (measurement.value / maxValue) * chartHeight;
        const y = canvas.height - barHeight - 30;

        // Draw bar
        ctx.fillStyle = measurement.color;
        ctx.fillRect(x, y, barWidth, barHeight);

        // Draw label
        ctx.fillStyle = '#374151';
        ctx.font = '12px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText(measurement.label, x + barWidth / 2, canvas.height - 10);

        // Draw value
        ctx.fillText(measurement.value + 'cm', x + barWidth / 2, y - 5);
      });
    }

    updateFitScores() {
      // This would update the fit score bars with actual calculated values
      // For now, we'll use the static values from the HTML
    }

    saveMeasurements() {
      const measurementsData = {
        ...this.measurements,
        preferences: this.preferences,
        timestamp: new Date().toISOString()
      };

      localStorage.setItem('sizePredictorMeasurements', JSON.stringify(measurementsData));
      this.showNotification('{{ 'products.size_predictor.measurements_saved' | t }}', 'success');
    }

    loadSavedMeasurements() {
      const saved = localStorage.getItem('sizePredictorMeasurements');
      if (saved) {
        const data = JSON.parse(saved);

        // Populate saved measurements
        Object.keys(this.measurements).forEach(key => {
          if (data[key] !== undefined) {
            this.measurements[key] = data[key];

            // Update UI
            const input = this.container.querySelector(`#${key}`);
            if (input) {
              input.value = data[key];
            }
          }
        });

        // Populate saved preferences
        if (data.preferences) {
          Object.assign(this.preferences, data.preferences);
        }

        // Update gender selection
        if (data.gender) {
          this.selectGender(data.gender);
        }

        // Update size system
        if (data.sizeSystem) {
          this.selectSizeSystem(data.sizeSystem);
        }
      }
    }

    addToCart(size) {
      // Add product to cart with selected size
      const variantId = this.getVariantIdForSize(size);

      if (variantId) {
        fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            id: variantId,
            quantity: 1,
            properties: {
              '_size_predictor_recommendation': 'true',
              '_recommended_size': size,
              '_confidence_score': this.recommendation.confidence + '%'
            }
          })
        })
        .then(response => response.json())
        .then(data => {
          if (data.status === 422) {
            this.showNotification(data.message, 'error');
          } else {
            this.showNotification('{{ 'products.size_predictor.added_to_cart' | t }}', 'success');
            this.updateCartCounter();
          }
        })
        .catch(error => {
          console.error('Error adding to cart:', error);
          this.showNotification('{{ 'products.size_predictor.add_to_cart_error' | t }}', 'error');
        });
      } else {
        this.showNotification('{{ 'products.size_predictor.size_not_available' | t }}', 'error');
      }
    }

    getVariantIdForSize(size) {
      // This would need to be implemented based on the actual product variants
      // For now, return a placeholder
      return '{{ product.selected_or_first_available_variant.id }}';
    }

    updateCartCounter() {
      // Update cart counter if it exists
      const cartCounter = document.querySelector('.cart-counter');
      if (cartCounter) {
        fetch('/cart.js')
          .then(response => response.json())
          .then(cart => {
            cartCounter.textContent = cart.item_count;
          });
      }
    }

    shareResults() {
      const shareData = {
        title: '{{ product.title }} - Size Recommendation',
        text: `My recommended size: ${this.recommendation.size} (${this.recommendation.confidence}% confidence)`,
        url: window.location.href
      };

      if (navigator.share) {
        navigator.share(shareData).catch(() => {
          this.fallbackShare();
        });
      } else {
        this.fallbackShare();
      }
    }

    fallbackShare() {
      const shareUrl = window.location.href;
      navigator.clipboard.writeText(shareUrl).then(() => {
        this.showNotification('{{ 'products.size_predictor.link_copied' | t }}', 'success');
      });
    }

    restart() {
      this.currentStep = 1;
      this.measurements = {
        gender: '',
        height: null,
        weight: null,
        chest: null,
        waist: null,
        hips: null,
        bodyType: '',
        sizeSystem: 'INT'
      };
      this.preferences = {
        fit: 'regular',
        comfort: {
          breathability: 3,
          movement: 3,
          style: 3
        },
        issues: [],
        fabric: 'stretch'
      };

      // Reset UI
      this.container.querySelectorAll('.measurement-input').forEach(input => {
        input.value = '';
      });

      this.container.querySelectorAll('.gender-option, .fit-option, .size-system-option, .fabric-option').forEach(btn => {
        btn.classList.remove('active');
      });

      this.container.querySelectorAll('.issue-checkbox').forEach(checkbox => {
        checkbox.checked = false;
      });

      this.container.querySelectorAll('.comfort-slider').forEach(slider => {
        slider.value = 3;
      });

      this.updateStepDisplay();
      this.updateStepProgress();
    }

    showNotification(message, type = 'info') {
      const notification = document.createElement('div');
      notification.className = `fixed top-4 right-4 px-6 py-3 rounded-lg text-white z-50 transition-all transform translate-x-full`;

      switch(type) {
        case 'success':
          notification.classList.add('bg-green-500');
          break;
        case 'error':
          notification.classList.add('bg-red-500');
          break;
        default:
          notification.classList.add('bg-blue-500');
      }

      notification.textContent = message;
      document.body.appendChild(notification);

      setTimeout(() => {
        notification.classList.remove('translate-x-full');
      }, 100);

      setTimeout(() => {
        notification.classList.add('translate-x-full');
        setTimeout(() => {
          document.body.removeChild(notification);
        }, 300);
      }, 3000);
    }
  }

  // Initialize size predictor
  const predictorContainers = document.querySelectorAll('.size-predictor');
  predictorContainers.forEach(container => {
    new SizePredictor(container);
  });

  // Make available globally for Shopify integration
  window.theme = window.theme || {};
  window.theme.sizePredictor = SizePredictor;
});
</script>