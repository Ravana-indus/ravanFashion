  init() {
    this.setupEventListeners();
    this.updateProgress();
  }

  setupEventListeners() {
    // Start quiz button
    const startBtn = document.getElementById('start-quiz');
    if (startBtn) {
      startBtn.addEventListener('click', () => this.startQuiz());
    }

    // Retake quiz button
    const retakeBtn = document.getElementById('retake-quiz');
    if (retakeBtn) {
      retakeBtn.addEventListener('click', () => this.retakeQuiz());
    }

    // Save results button
    const saveBtn = document.getElementById('save-results');
    if (saveBtn) {
      saveBtn.addEventListener('click', () => this.saveResults());
    }

    // Shop style button
    const shopBtn = document.getElementById('shop-style');
    if (shopBtn) {
      shopBtn.addEventListener('click', () => this.shopStyle());
    }
  }

  startQuiz() {
    document.getElementById('quiz-welcome').classList.add('hidden');
    document.getElementById('quiz-questions').classList.remove('hidden');
    this.showQuestion(0);
  }

  showQuestion(index) {
    const questionContainer = document.getElementById('quiz-questions');
    const question = this.questions[index];

    let questionHTML = `
      <div class="question-card bg-white rounded-lg shadow-lg p-8">
        <h4 class="text-xl font-semibold mb-6 text-center">${this.escapeHtml(question.question)}</h4>
        <div class="options-grid grid grid-cols-1 md:grid-cols-2 gap-4">
    `;

    question.options.forEach((option, optionIndex) => {
      const isSelected = this.answers[question.id] === option.value;
      const selectedClass = isSelected ? 'selected' : '';

      questionHTML += `
        <div class="quiz-option ${selectedClass} bg-gray-50 rounded-lg p-4 border-2 border-gray-200"
             data-question="${question.id}" data-value="${option.value}">
          <div class="flex items-center gap-3">
            <div class="style-icon text-2xl">${option.icon}</div>
            <div class="flex-1">
              <p class="font-medium text-gray-800">${this.escapeHtml(option.label)}</p>
              ${option.colors ? `
                <div class="flex gap-1 mt-1">
                  ${option.colors.map(color =>
                    `<div class="w-4 h-4 rounded-full" style="background-color: ${color}"></div>`
                  ).join('')}
                </div>
              ` : ''}
            </div>
            <div class="radio-circle w-6 h-6 rounded-full border-2 border-gray-300 flex items-center justify-center">
              ${isSelected ? '<div class="w-3 h-3 rounded-full bg-purple-600"></div>' : ''}
            </div>
          </div>
        </div>
      `;
    });

    questionHTML += `
        </div>
        <div class="navigation-buttons mt-8 flex justify-between">
          <button id="prev-question" class="bg-gray-200 text-gray-800 px-6 py-2 rounded-lg hover:bg-gray-300 transition-colors ${index === 0 ? 'opacity-50 cursor-not-allowed' : ''}"
                    ${index === 0 ? 'disabled' : ''}>
            <span data-i18n="style_quiz.previous">Previous</span>
          </button>
          <button id="next-question" class="bg-gradient-to-r from-purple-600 to-pink-600 text-white px-6 py-2 rounded-lg hover:from-purple-700 hover:to-pink-700 transition-all duration-200">
            ${index === this.questions.length - 1 ?
              '<span data-i18n="style_quiz.finish">Finish</span>' :
              '<span data-i18n="style_quiz.next">Next</span>'
            }
          </button>
        </div>
      </div>
    `;

    questionContainer.innerHTML = questionHTML;

    // Add event listeners to options
    questionContainer.querySelectorAll('.quiz-option').forEach(option => {
      option.addEventListener('click', () => this.selectOption(option));
    });

    // Add navigation listeners
    const prevBtn = document.getElementById('prev-question');
    const nextBtn = document.getElementById('next-question');

    if (prevBtn) {
      prevBtn.addEventListener('click', () => this.previousQuestion());
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => this.nextQuestion());
    }

    this.updateProgress();
  }

  selectOption(optionElement) {
    const questionId = optionElement.dataset.question;
    const value = optionElement.dataset.value;

    // Update answer
    this.answers[questionId] = value;

    // Update UI
    const questionCard = optionElement.closest('.question-card');
    questionCard.querySelectorAll('.quiz-option').forEach(opt => {
      opt.classList.remove('selected');
      opt.querySelector('.radio-circle').innerHTML = '';
    });

    optionElement.classList.add('selected');
    optionElement.querySelector('.radio-circle').innerHTML = '<div class="w-3 h-3 rounded-full bg-purple-600"></div>';
  }

  nextQuestion() {
    if (this.currentQuestion < this.questions.length - 1) {
      this.currentQuestion++;
      this.showQuestion(this.currentQuestion);
    } else {
      this.finishQuiz();
    }
  }

  previousQuestion() {
    if (this.currentQuestion > 0) {
      this.currentQuestion--;
      this.showQuestion(this.currentQuestion);
    }
  }

  updateProgress() {
    const currentEl = document.getElementById('current-question');
    const totalEl = document.getElementById('total-questions');
    const progressBar = document.getElementById('progress-bar');

    if (currentEl) currentEl.textContent = this.currentQuestion + 1;
    if (totalEl) totalEl.textContent = this.questions.length;
    if (progressBar) {
      const progress = ((this.currentQuestion + 1) / this.questions.length) * 100;
      progressBar.style.width = `${progress}%`;
    }
  }

  finishQuiz() {
    const result = this.calculateResult();
    this.showResults(result);
  }

  calculateResult() {
    // Simple scoring system based on answers
    let scores = {
      'Traditional Elegance': 0,
      'Modern Fusion': 0,
      'Bohemian Spirit': 0,
      'Professional Chic': 0,
      'Creative Artist': 0,
      'Comfort Queen': 0,
      'Trendsetter': 0,
      'Cultural Ambassador': 0
    };

    // Score based on answers
    Object.entries(this.answers).forEach(([questionId, answer]) => {
      switch (questionId) {
        case 'lifestyle':
          if (['professional', 'cultural'].includes(answer)) {
            scores['Traditional Elegance'] += 2;
            scores['Professional Chic'] += 2;
            scores['Cultural Ambassador'] += 2;
          }
          if (['creative', 'social'].includes(answer)) {
            scores['Modern Fusion'] += 2;
            scores['Creative Artist'] += 2;
            scores['Trendsetter'] += 2;
          }
          if (['relaxed'].includes(answer)) {
            scores['Bohemian Spirit'] += 2;
            scores['Comfort Queen'] += 2;
          }
          break;

        case 'cultural_preference':
          if (answer === 'traditional') {
            scores['Traditional Elegance'] += 3;
            scores['Cultural Ambassador'] += 3;
          }
          if (answer === 'fusion') {
            scores['Modern Fusion'] += 3;
            scores['Creative Artist'] += 2;
          }
          if (answer === 'subtle') {
            scores['Professional Chic'] += 2;
            scores['Comfort Queen'] += 2;
          }
          break;

        case 'style_priority':
          if (answer === 'quality') {
            scores['Traditional Elegance'] += 2;
            scores['Professional Chic'] += 2;
          }
          if (answer === 'trendy') {
            scores['Trendsetter'] += 3;
            scores['Modern Fusion'] += 2;
          }
          if (answer === 'expression') {
            scores['Creative Artist'] += 3;
            scores['Bohemian Spirit'] += 2;
          }
          if (answer === 'comfort') {
            scores['Comfort Queen'] += 3;
            scores['Bohemian Spirit'] += 2;
          }
          break;

        case 'color_preference':
          if (answer === 'neutral') {
            scores['Professional Chic'] += 2;
            scores['Traditional Elegance'] += 2;
          }
          if (answer === 'bold' || answer === 'jewel') {
            scores['Creative Artist'] += 2;
            scores['Trendsetter'] += 2;
          }
          if (answer === 'earth') {
            scores['Bohemian Spirit'] += 2;
            scores['Comfort Queen'] += 2;
          }
          break;

        case 'accessories':
          if (answer === 'traditional') {
            scores['Traditional Elegance'] += 2;
            scores['Cultural Ambassador'] += 2;
          }
          if (answer === 'statement') {
            scores['Trendsetter'] += 2;
            scores['Creative Artist'] += 2;
          }
          if (answer === 'minimal') {
            scores['Professional Chic'] += 2;
            scores['Comfort Queen'] += 1;
          }
          break;
      }
    });

    // Find highest score
    let maxScore = 0;
    let result = 'Modern Fusion'; // Default

    Object.entries(scores).forEach(([style, score]) => {
      if (score > maxScore) {
        maxScore = score;
        result = style;
      }
    });

    return result;
  }

  showResults(styleName) {
    const profile = this.styleProfiles[styleName];

    // Hide questions, show results
    document.getElementById('quiz-questions').classList.add('hidden');
    document.getElementById('quiz-results').classList.remove('hidden');

    // Update result content
    document.getElementById('style-emoji').textContent = profile.emoji;
    document.getElementById('style-name').textContent = styleName;
    document.getElementById('style-description').textContent = profile.description;

    // Update traits
    const traitsContainer = document.getElementById('style-traits');
    traitsContainer.innerHTML = profile.traits.map(trait => `
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-purple-600" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
        </svg>
        <span class="text-sm text-gray-700">${trait}</span>
      </div>
    `).join('');

    // Update recommendations
    const recommendationsContainer = document.getElementById('style-recommendations');
    recommendationsContainer.innerHTML = profile.recommendations.map(rec => `
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-pink-600" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
        </svg>
        <span class="text-sm text-gray-700">${rec}</span>
      </div>
    `).join('');

    // Update color palette
    const colorContainer = document.getElementById('color-swatches');
    colorContainer.innerHTML = profile.colors.map(color => `
      <div class="color-swatch w-12 h-12 rounded-lg shadow-md cursor-pointer"
           style="background-color: ${color}"
           title="${color}">
      </div>
    `).join('');

    // Update cultural text
    document.getElementById('cultural-text').textContent = profile.cultural;

    // Store results
    this.quizResults = {
      styleName,
      profile,
      answers: this.answers,
      timestamp: new Date().toISOString()
    };

    this.quizCompleted = true;
  }

  retakeQuiz() {
    this.currentQuestion = 0;
    this.answers = {};
    this.quizCompleted = false;

    document.getElementById('quiz-results').classList.add('hidden');
    document.getElementById('quiz-welcome').classList.remove('hidden');
  }

  saveResults() {
    if (!this.quizResults) return;

    // Save to localStorage
    const savedQuizzes = JSON.parse(localStorage.getItem('style-quiz-results') || '[]');
    savedQuizzes.push(this.quizResults);
    localStorage.setItem('style-quiz-results', JSON.stringify(savedQuizzes.slice(-5))); // Keep last 5

    // Update virtual stylist profile if available
    if (window.theme.virtualStylist) {
      const stylistProfile = window.theme.virtualStylist.userProfile || {};

      // Map quiz results to stylist profile
      const styleMapping = {
        'Traditional Elegance': 'traditional',
        'Modern Fusion': 'fusion',
        'Bohemian Spirit': 'bohemian',
        'Professional Chic': 'modern',
        'Creative Artist': 'creative',
        'Comfort Queen': 'minimalist',
        'Trendsetter': 'modern',
        'Cultural Ambassador': 'traditional'
      };

      stylistProfile.stylePreference = styleMapping[this.quizResults.styleName] || 'fusion';
      stylistProfile.quizResults = this.quizResults;
      stylistProfile.updatedAt = new Date().toISOString();

      localStorage.setItem('virtual-stylist-profile', JSON.stringify(stylistProfile));
    }

    // Show confirmation
    this.showNotification('Results saved successfully!', 'success');
  }

  shopStyle() {
    if (!this.quizResults) return;

    // Navigate to collections or products based on style
    const styleMapping = {
      'Traditional Elegance': '/collections/traditional-wear',
      'Modern Fusion': '/collections/fusion-wear',
      'Bohemian Spirit': '/collections/bohemian',
      'Professional Chic': '/collections/work-wear',
      'Creative Artist': '/collections/statement-pieces',
      'Comfort Queen': '/collections/comfy-chic',
      'Trendsetter': '/collections/trending-now',
      'Cultural Ambassador': '/collections/cultural-heritage'
    };

    const url = styleMapping[this.quizResults.styleName] || '/collections/all';
    window.location.href = url;
  }

  shareOnSocial(platform) {
    if (!this.quizResults) return;

    const text = `I just discovered my style personality: ${this.quizResults.styleName}! 🌟 ${this.quizResults.profile.description}`;
    const url = window.location.href;

    const shareUrls = {
      facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}&quote=${encodeURIComponent(text)}`,
      twitter: `https://twitter.com/intent/tweet?text=${encodeURIComponent(text)}&url=${encodeURIComponent(url)}`,
      pinterest: `https://pinterest.com/pin/create/button/?url=${encodeURIComponent(url)}&description=${encodeURIComponent(text)}`
    };

    if (shareUrls[platform]) {
      window.open(shareUrls[platform], '_blank', 'width=600,height=400');
    }
  }

  copyResults() {
    if (!this.quizResults) return;

    const text = `My Style Personality: ${this.quizResults.styleName}\n\n${this.quizResults.profile.description}\n\nKey Traits:\n${this.quizResults.profile.traits.join('\n')}\n\nTake the quiz yourself!`;

    navigator.clipboard.writeText(text).then(() => {
      this.showNotification('Results copied to clipboard!', 'success');
    });
  }

  showNotification(message, type = 'info') {
    const notification = document.createElement('div');
    notification.className = `fixed top-4 right-4 p-4 rounded-lg shadow-lg z-50 ${
      type === 'success' ? 'bg-green-500 text-white' : 'bg-blue-500 text-white'
    }`;
    notification.textContent = message;

    document.body.appendChild(notification);

    setTimeout(() => {
      notification.remove();
    }, 3000);
  }

  escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }
}

// Initialize Style Quiz
document.addEventListener('DOMContentLoaded', function() {
  const quizContainer = document.querySelector('[data-quiz-id="style-preference-quiz"]');
  if (quizContainer) {
    window.theme.styleQuiz = new StyleQuiz(quizContainer);
  }
});
</script>