{%- comment -%}
Style Quiz - Interactive style preference quiz
Helps users discover their personal style through engaging questions
{%- endcomment -%}

<div class="style-quiz" data-quiz-id="style-preference-quiz">
  <!-- Quiz Header -->
  <div class="quiz-header text-center mb-8">
    <div class="quiz-icon mb-4">
      <div class="w-20 h-20 mx-auto rounded-full bg-gradient-to-br from-purple-500 to-pink-500 flex items-center justify-center text-white text-3xl">
        <svg class="w-10 h-10" fill="currentColor" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
        </svg>
      </div>
    </div>
    <h3 class="text-2xl font-bold text-gray-800 mb-2" data-i18n="style_quiz.title">Discover Your Style</h3>
    <p class="text-gray-600" data-i18n="style_quiz.subtitle">Answer a few questions to uncover your unique fashion personality</p>
  </div>

  <!-- Progress Bar -->
  <div class="quiz-progress mb-8">
    <div class="flex items-center justify-between mb-2">
      <span class="text-sm font-medium text-gray-700" data-i18n="style_quiz.progress">Progress</span>
      <span class="text-sm text-gray-600">
        <span id="current-question">1</span> / <span id="total-questions">8</span>
      </span>
    </div>
    <div class="w-full bg-gray-200 rounded-full h-2">
      <div id="progress-bar" class="bg-gradient-to-r from-purple-600 to-pink-600 h-2 rounded-full transition-all duration-300" style="width: 12.5%"></div>
    </div>
  </div>

  <!-- Quiz Container -->
  <div class="quiz-container max-w-2xl mx-auto">
    <!-- Welcome Screen -->
    <div id="quiz-welcome" class="quiz-screen">
      <div class="bg-white rounded-lg shadow-lg p-8 text-center">
        <h4 class="text-xl font-semibold mb-4" data-i18n="style_quiz.welcome_title">Find Your Perfect Style!</h4>
        <p class="text-gray-600 mb-6" data-i18n="style_quiz.welcome_description">
          This quick quiz will help you discover your personal style preferences and get customized fashion recommendations tailored just for you.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
          <div class="feature-card">
            <div class="w-12 h-12 mx-auto mb-2 bg-purple-100 rounded-full flex items-center justify-center">
              <svg class="w-6 h-6 text-purple-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/>
              </svg>
            </div>
            <p class="text-sm font-medium" data-i18n="style_quiz.feature_1">Personalized Results</p>
          </div>
          <div class="feature-card">
            <div class="w-12 h-12 mx-auto mb-2 bg-pink-100 rounded-full flex items-center justify-center">
              <svg class="w-6 h-6 text-pink-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M6.672 1.911a1 1 0 10-1.932.518l.259.966a1 1 0 001.932-.518l-.26-.966zM2.429 4.74a1 1 0 10-.517 1.932l.966.259a1 1 0 00.517-1.932l-.966-.26zm8.814-.569a1 1 0 00-1.415-1.414l-.707.707a1 1 0 101.415 1.415l.707-.708zm-7.071 7.072l.707-.707A1 1 0 003.465 9.12l-.708.707a1 1 0 001.415 1.415zm3.2-5.171a1 1 0 00-1.3 1.3l4 10a1 1 0 001.823.075l1.38-2.759 3.018 3.02a1 1 0 001.414-1.415l-3.019-3.02 2.76-1.379a1 1 0 00-.076-1.822l-10-4z" clip-rule="evenodd"/>
              </svg>
            </div>
            <p class="text-sm font-medium" data-i18n="style_quiz.feature_2">Quick & Easy</p>
          </div>
          <div class="feature-card">
            <div class="w-12 h-12 mx-auto mb-2 bg-blue-100 rounded-full flex items-center justify-center">
              <svg class="w-6 h-6 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M3 5a2 2 0 012-2h10a2 2 0 012 2v8a2 2 0 01-2 2h-2.22l.123.489.804.804A1 1 0 0115 15H5a1 1 0 01-.707-1.707l.804-.804L5.22 13H5a2 2 0 01-2-2V5zm5.771 7H5V5h10v7H8.771z" clip-rule="evenodd"/>
              </svg>
            </div>
            <p class="text-sm font-medium" data-i18n="style_quiz.feature_3">Cultural Insights</p>
          </div>
        </div>
        <button id="start-quiz" class="bg-gradient-to-r from-purple-600 to-pink-600 text-white px-8 py-3 rounded-lg hover:from-purple-700 hover:to-pink-700 transition-all duration-200 font-medium">
          <span data-i18n="style_quiz.start_quiz">Start Quiz</span>
        </button>
      </div>
    </div>

    <!-- Questions Container -->
    <div id="quiz-questions" class="quiz-screen hidden">
      <!-- Questions will be dynamically inserted here -->
    </div>

    <!-- Results Screen -->
    <div id="quiz-results" class="quiz-screen hidden">
      <div class="bg-white rounded-lg shadow-lg p-8">
        <div class="text-center mb-8">
          <div class="w-24 h-24 mx-auto mb-4 rounded-full bg-gradient-to-br from-purple-500 to-pink-500 flex items-center justify-center text-white text-4xl">
            <span id="style-emoji">✨</span>
          </div>
          <h4 class="text-2xl font-bold text-gray-800 mb-2" id="style-name">Your Style Name</h4>
          <p class="text-gray-600" id="style-description">Your style description</p>
        </div>

        <!-- Style Details -->
        <div class="grid md:grid-cols-2 gap-6 mb-8">
          <div class="style-details">
            <h5 class="text-lg font-semibold mb-3 flex items-center gap-2">
              <svg class="w-5 h-5 text-purple-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M3 5a2 2 0 012-2h10a2 2 0 012 2v8a2 2 0 01-2 2h-2.22l.123.489.804.804A1 1 0 0115 15H5a1 1 0 01-.707-1.707l.804-.804L5.22 13H5a2 2 0 01-2-2V5zm5.771 7H5V5h10v7H8.771z" clip-rule="evenodd"/>
              </svg>
              <span data-i18n="style_quiz.key_traits">Key Style Traits</span>
            </h5>
            <div id="style-traits" class="space-y-2">
              <!-- Traits will be dynamically inserted -->
            </div>
          </div>

          <div class="style-recommendations">
            <h5 class="text-lg font-semibold mb-3 flex items-center gap-2">
              <svg class="w-5 h-5 text-pink-600" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
              <span data-i18n="style_quiz.recommendations">Perfect For You</span>
            </h5>
            <div id="style-recommendations" class="space-y-2">
              <!-- Recommendations will be dynamically inserted -->
            </div>
          </div>
        </div>

        <!-- Color Palette -->
        <div class="color-palette mb-8">
          <h5 class="text-lg font-semibold mb-3" data-i18n="style_quiz.color_palette">Your Color Palette</h5>
          <div class="flex gap-3" id="color-swatches">
            <!-- Color swatches will be dynamically inserted -->
          </div>
        </div>

        <!-- Cultural Connection -->
        <div class="cultural-connection mb-8">
          <h5 class="text-lg font-semibold mb-3 flex items-center gap-2">
            <svg class="w-5 h-5 text-green-600" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span data-i18n="style_quiz.cultural_connection">Cultural Style Connection</span>
          </h5>
          <p id="cultural-text" class="text-gray-600 mb-4">Your cultural style connection text</p>
        </div>

        <!-- Action Buttons -->
        <div class="flex gap-4 justify-center">
          <button id="retake-quiz" class="bg-gray-200 text-gray-800 px-6 py-2 rounded-lg hover:bg-gray-300 transition-colors">
            <span data-i18n="style_quiz.retake">Retake Quiz</span>
          </button>
          <button id="save-results" class="bg-gradient-to-r from-purple-600 to-pink-600 text-white px-6 py-2 rounded-lg hover:from-purple-700 hover:to-pink-700 transition-all duration-200">
            <span data-i18n="style_quiz.save_results">Save Results</span>
          </button>
          <button id="shop-style" class="bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700 transition-colors">
            <span data-i18n="style_quiz.shop_style">Shop Your Style</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Share Results -->
  <div id="share-modal" class="modal fade" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" data-i18n="style_quiz.share_title">Share Your Style</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="share-preview mb-4 p-4 bg-gray-50 rounded-lg">
            <h6 class="font-semibold mb-2" id="share-style-name">My Style Personality</h6>
            <p class="text-sm text-gray-600 mb-2" id="share-style-description">Style description</p>
            <div class="flex gap-2 mb-2" id="share-colors">
              <!-- Share colors will be inserted -->
            </div>
          </div>
          <div class="share-buttons">
            <button class="btn btn-primary mb-2" onclick="window.theme.styleQuiz.shareOnSocial('facebook')">
              <i class="fab fa-facebook-f me-2"></i>Facebook
            </button>
            <button class="btn btn-info mb-2" onclick="window.theme.styleQuiz.shareOnSocial('twitter')">
              <i class="fab fa-twitter me-2"></i>Twitter
            </button>
            <button class="btn btn-danger mb-2" onclick="window.theme.styleQuiz.shareOnSocial('pinterest')">
              <i class="fab fa-pinterest me-2"></i>Pinterest
            </button>
            <button class="btn btn-secondary mb-2" onclick="window.theme.styleQuiz.copyResults()">
              <i class="fas fa-copy me-2"></i>Copy Link
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
.style-quiz {
  font-family: 'Inter', system-ui, -apple-system, sans-serif;
}

.quiz-screen {
  animation: fadeIn 0.5s ease-in-out;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.feature-card {
  transition: transform 0.2s ease;
}

.feature-card:hover {
  transform: translateY(-2px);
}

.quiz-option {
  transition: all 0.3s ease;
  cursor: pointer;
  border: 2px solid transparent;
}

.quiz-option:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
}

.quiz-option.selected {
  border-color: #8b5cf6;
  background: linear-gradient(135deg, #f3f4f6 0%, #e5e7eb 100%);
}

.style-icon {
  transition: transform 0.3s ease;
}

.quiz-option:hover .style-icon {
  transform: scale(1.1);
}

.color-swatch {
  transition: transform 0.2s ease;
}

.color-swatch:hover {
  transform: scale(1.1);
}

.progress-bar {
  transition: width 0.5s ease-in-out;
}

.question-image {
  transition: transform 0.3s ease;
}

.question-image:hover {
  transform: scale(1.05);
}

@media (max-width: 768px) {
  .quiz-container {
    padding: 0 1rem;
  }

  .flex.gap-4 {
    flex-direction: column;
  }

  .btn {
    width: 100%;
  }
}
</style>

