      },
      'Creative Artist': {
        emoji: '🎨',
        description: 'Expressive and unique with bold experimentation in colors and patterns',
        traits: ['Creative visionary', 'Trendsetter', 'Bold experimenter', 'Cultural innovator'],
        recommendations: ['Mixed patterns and textures', 'Bold color combinations', 'Customized and personalized pieces', 'Art draping and unique silhouettes'],
        colors: ['#FF1493', '#00CED1', '#FFD700', '#9370DB'],
