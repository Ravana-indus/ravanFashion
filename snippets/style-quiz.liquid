      },
      'Comfort Queen': {
        emoji: '👑',
        description: 'Comfort-first approach without compromising on style and cultural elements',
        traits: ['Comfort seeker', 'Practical thinker', 'Style conscious', 'Cultural appreciation'],
        recommendations: ['Comfortable yet stylish fusion wear', 'Easy-to-wear traditional pieces', 'Soft fabrics with beautiful drape', 'Versatile layering options'],
        colors: ['#F0E68C', '#87CEEB', '#DDA0DD', '#98FB98'],
        cultural: 'You prioritize comfort while maintaining cultural connections through smart, practical fashion choices.'
      },
      'Trendsetter': {
        emoji: '🔥',
        description: 'Always ahead of trends with a confident and bold style',
        traits: ['Fashion forward', 'Confident', 'Trend aware', 'Style influencer'],
        recommendations: ['Latest fashion with cultural twists', 'Statement pieces and bold accessories', 'Experimental silhouettes', 'Social media worthy outfits'],
        colors: ['#FF1744', '#2979FF', '#00E676', '#FFEA00'],
        cultural: 'You set trends rather than follow them, bringing Tamil cultural elements into contemporary fashion conversations.'
      },
      'Cultural Ambassador': {
        emoji: '🌍',
        description: 'Proud representative of Tamil culture through fashion',
        traits: ['Cultural pride', 'Traditional values', 'Graceful presence', 'Knowledge sharing'],
        recommendations: ['Authentic traditional wear', 'Handcrafted and artisanal pieces', 'Cultural storytelling through fashion', 'Event-specific traditional attire'],
