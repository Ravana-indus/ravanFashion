        description: 'Free-spirited and artistic with flowing silhouettes and cultural elements',
        traits: ['Free-spirited', 'Artistic soul', 'Nature lover', 'Comfort seeker'],
        recommendations: ['Flowy kurtas and palazzos', 'Embroidered and handcrafted pieces', 'Natural fabrics and earthy tones', 'Layered accessories'],
        colors: ['#8FBC8F', '#DEB887', '#DDA0DD', '#F0E68C'],
        cultural: 'Your bohemian spirit connects with traditional crafts and techniques, creating a style that\'s both global and locally rooted.'
      },
      'Professional Chic': {
        emoji: '💼',
        description: 'Polished and professional with cultural sophistication',
        traits: ['Ambitious', 'Detail-oriented', 'Confident', 'Culturally aware'],
        recommendations: ['Tailored blazers with ethnic prints', 'Structured silhouettes in traditional fabrics', 'Professional yet culturally appropriate accessories', 'Versatile pieces for work and events'],
        colors: ['#2F4F4F', '#800080', '#000080', '#696969'],
