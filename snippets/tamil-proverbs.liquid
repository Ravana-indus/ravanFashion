{%- comment -%}
  Tamil Proverbs Rotator Snippet
  Displays rotating Tamil proverbs with English translations
{%- endcomment -%}

<div class="tamil-proverbs bg-cream-white text-charcoal-black p-8 rounded-lg shadow-lg border border-gold border-opacity-30">
  <div class="text-center mb-6">
    <h3 class="text-2xl font-bold text-deep-maroon mb-2">
      {% render 'translation', key: 'proverbs.title', default: 'Tamil Wisdom' %}
    </h3>
    <p class="text-gold font-tamil text-lg">
      {% render 'translation', key: 'proverbs.subtitle_tamil', default: 'தமிழ் பழமொழிகள்' %}
    </p>
  </div>

  <div class="proverb-rotator relative min-h-[200px] flex items-center justify-center">
    <!-- Proverb Container -->
    <div class="proverb-content text-center space-y-4 opacity-0 transition-opacity duration-1000">
      <!-- Tamil Proverb -->
      <blockquote class="proverb-tamil text-3xl font-tamil text-gold leading-relaxed">
        "அறிவுடையார் எல்லாம் அறிந்தார், அறிவில்லாதவர் எதுவும் அறியார்."
      </blockquote>

      <!-- English Translation -->
      <p class="proverb-english text-lg text-gray-700 italic">
        The wise know everything, the foolish know nothing.
      </p>

      <!-- Meaning/Explanation -->
      <p class="proverb-meaning text-sm text-gray-600 max-w-2xl mx-auto">
        This proverb emphasizes the value of wisdom and knowledge in Tamil culture.
      </p>

      <!-- Cultural Context -->
      <div class="cultural-context mt-4 p-4 bg-gold bg-opacity-10 rounded-lg">
        <p class="text-sm text-deep-maroon">
          <span class="font-semibold">Cultural Context:</span>
          Tamil proverbs (பழமொழி) have been passed down through generations, offering guidance on ethics, morality, and daily life.
        </p>
      </div>
    </div>

    <!-- Navigation Dots -->
    <div class="proverb-dots flex justify-center mt-8 space-x-2">
      <!-- Dots will be generated by JavaScript -->
    </div>

    <!-- Navigation Arrows -->
    <button class="proverb-prev absolute left-0 top-1/2 transform -translate-y-1/2 bg-gold bg-opacity-20 hover:bg-opacity-40 p-2 rounded-full transition-all duration-300" aria-label="Previous proverb">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
    </button>

    <button class="proverb-next absolute right-0 top-1/2 transform -translate-y-1/2 bg-gold bg-opacity-20 hover:bg-opacity-40 p-2 rounded-full transition-all duration-300" aria-label="Next proverb">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
      </svg>
    </button>
  </div>

  <!-- Auto-rotation Toggle -->
  <div class="text-center mt-6">
    <button class="auto-rotate-toggle bg-gold text-charcoal-black px-4 py-2 rounded-full text-sm font-medium hover:bg-yellow-500 transition-colors" data-active="true">
      {% render 'translation', key: 'proverbs.auto_rotate', default: 'Auto-rotate: ON' %}
    </button>
  </div>
</div>

<!-- Proverbs Data (stored in JavaScript for rotation) -->
