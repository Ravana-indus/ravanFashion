<button
  class="p-2 hover:bg-gray-100 rounded-full transition-colors relative"
  onclick="window.theme.toggleCart()"
  aria-label="Toggle cart"
>
  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"
    ></path>
  </svg>
  <span
    class="cart-item-count absolute -top-1 -right-1 bg-deep-maroon text-white text-xs rounded-full h-5 w-5 flex items-center justify-center font-medium"
  >
    {{ cart.item_count }}
  </span>
</button>