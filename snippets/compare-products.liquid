      price: 89.99,
      comparePrice: null,
      rating: 4.3,
      reviews: 89,
      image: 'https://picsum.photos/seed/kurta/400/300.jpg',
      category: 'mens-wear',
      availability: 'in_stock',
      material: 'Cotton Blend',
      size: 'S, M, L, XL',
      color: 'Cream with Gold Embroidery',
      care_instructions: 'Machine wash cold',
      origin: 'Modern Design',
      sustainability: 'Sustainable materials',
      cultural_significance: 'Fusion wear',
      features: {
        material: 'Cotton Blend',
        size: 'S, M, L, XL',
        color: 'Cream with Gold Embroidery',
        care_instructions: 'Machine wash cold',
        origin: 'Modern Design',
        sustainability: 'Sustainable materials',
        cultural_significance: 'Fusion wear'
      }
    },
    {
      id: 'temple-jewelry',
      title: 'Traditional Temple Jewelry Set',
      price: 199.99,
      comparePrice: 249.99,
      rating: 4.9,
      reviews: 234,
      image: 'https://picsum.photos/seed/jewelry/400/300.jpg',
      category: 'jewelry',
      availability: 'in_stock',
      material: 'Gold Plated Silver',
      size: 'Adjustable',
      color: 'Antique Gold',
      care_instructions: 'Avoid water and chemicals',
      origin: 'Traditional Craftsmen',
      sustainability: 'Handcrafted',
      cultural_significance: 'Temple traditional jewelry',
      features: {
        material: 'Gold Plated Silver',
        size: 'Adjustable',
        color: 'Antique Gold',
        care_instructions: 'Avoid water and chemicals',
        origin: 'Traditional Craftsmen',
        sustainability: 'Handcrafted',
        cultural_significance: 'Temple traditional jewelry'
      }
    },
    {
      id: 'festive-dress',
      title: 'Festive Occasion Dress',
      price: 159.99,
      comparePrice: null,
      rating: 4.5,
      reviews: 67,
      image: 'https://picsum.photos/seed/dress/400/300.jpg',
      category: 'womens-wear',
      availability: 'limited',
      material: 'Silk Blend',
      size: 'XS, S, M, L',
      color: 'Royal Blue',
