      features: {
        material: 'Silk Blend',
        size: 'XS, S, M, L',
        color: 'Royal Blue',
        care_instructions: 'Dry clean recommended',
        origin: 'Contemporary Design',
        sustainability: 'Eco-friendly dyes',
        cultural_significance: 'Modern festive wear'
      }
    },
    {
      id: 'ethnic-scarf',
      title: 'Handwoven Ethnic Scarf',
      price: 49.99,
      comparePrice: 69.99,
      rating: 4.2,
      reviews: 45,
      image: 'https://picsum.photos/seed/scarf/400/300.jpg',
      category: 'accessories',
      availability: 'in_stock',
      material: 'Cotton & Silk',
      size: '70" x 20"',
      color: 'Multi-color Traditional',
      care_instructions: 'Hand wash cold',
      origin: 'Village Artisans',
      sustainability: 'Handwoven traditional',
      cultural_significance: 'Traditional accessory',
      features: {
        material: 'Cotton & Silk',
        size: '70" x 20"',
        color: 'Multi-color Traditional',
        care_instructions: 'Hand wash cold',
        origin: 'Village Artisans',
        sustainability: 'Handwoven traditional',
        cultural_significance: 'Traditional accessory'
      }
    }
  ];

  // Initialize compare products
  window.theme.compareProducts.init = function() {
    window.theme.compareProducts.loadSelection();
    window.theme.compareProducts.loadProducts();
    window.theme.compareProducts.render();
  };

  // Load saved selection
  window.theme.compareProducts.loadSelection = function() {
    try {
      const stored = localStorage.getItem(window.theme.compareProducts.config.storageKey);
      if (stored) {
        window.theme.compareProducts.selectedProducts = JSON.parse(stored);
      }
    } catch (error) {
      console.warn('Failed to load compare selection:', error);
      window.theme.compareProducts.selectedProducts = [];
    }
  };

  // Save selection
  window.theme.compareProducts.saveSelection = function() {
    try {
      localStorage.setItem(
        window.theme.compareProducts.config.storageKey,
        JSON.stringify(window.theme.compareProducts.selectedProducts)
      );
    } catch (error) {
      console.warn('Failed to save compare selection:', error);
    }
  };

  // Load products
  window.theme.compareProducts.loadProducts = function() {
    window.theme.compareProducts.allProducts = window.theme.compareProducts.productDatabase;
  };

  // Render products grid
  window.theme.compareProducts.render = function() {
    const grid = document.getElementById('compare-products-grid');
    const empty = document.getElementById('compare-empty');
    const compareBtn = document.getElementById('compare-now-btn');

    let filteredProducts = window.theme.compareProducts.allProducts;

    // Apply category filter
    if (window.theme.compareProducts.currentFilter !== 'all') {
      filteredProducts = filteredProducts.filter(product => product.category === window.theme.compareProducts.currentFilter);
    }

    // Apply sorting
    filteredProducts = window.theme.compareProducts.sortProductsArray(filteredProducts, window.theme.compareProducts.currentSort);

    if (filteredProducts.length === 0) {
      grid.style.display = 'none';
      empty.style.display = 'block';
      return;
    }

    grid.style.display = 'grid';
    empty.style.display = 'none';

    grid.innerHTML = filteredProducts.map(product => {
      const isSelected = window.theme.compareProducts.selectedProducts.some(p => p.id === product.id);
      return `
        <div class="compare-product-card ${isSelected ? 'selected' : ''}" onclick="window.theme.compareProducts.toggleProduct('${product.id}')">
          <img src="${product.image}" alt="${product.title}" class="compare-product-image">
          <h4 class="compare-product-title">${product.title}</h4>
          <div class="compare-product-price">
            $${product.price}
            ${product.comparePrice ? `<span class="compare-at">$${product.comparePrice}</span>` : ''}
          </div>
          <div class="compare-product-rating">
            <div class="compare-rating-stars">
              ${window.theme.compareProducts.generateStars(product.rating)}
            </div>
            <span class="compare-rating-value">(${product.reviews})</span>
          </div>
          <div class="compare-product-availability ${product.availability === 'in_stock' ? 'availability-in-stock' : 'availability-out-of-stock'}">
            ${product.availability === 'in_stock' ? '{{ 'compare_products.in_stock' | t }}' : '{{ 'compare_products.out_of_stock' | t }}'}
          </div>
          <button class="compare-add-btn ${isSelected ? 'added' : ''}" onclick="event.stopPropagation(); window.theme.compareProducts.toggleProduct('${product.id}')">
            ${isSelected ? '{{ 'compare_products.remove_from_compare' | t }}' : '{{ 'compare_products.add_to_compare' | t }}'}
          </button>
        </div>
      `;
    }).join('');

    // Update compare button
    compareBtn.disabled = window.theme.compareProducts.selectedProducts.length < 2;
    compareBtn.textContent = `${window.theme.compareProducts.selectedProducts.length}/4 ${window.theme.compareProducts.selectedProducts.length < 2 ? '{{ 'compare_products.select_products' | t }}' : '{{ 'compare_products.compare_now' | t }}'}`;
  };

  // Generate star rating
  window.theme.compareProducts.generateStars = function(rating) {
    const fullStars = Math.floor(rating);
    const hasHalfStar = rating % 1 !== 0;
    let stars = '';

    for (let i = 0; i < fullStars; i++) {
      stars += '★';
    }
    if (hasHalfStar) {
      stars += '☆';
    }
    for (let i = fullStars + (hasHalfStar ? 1 : 0); i < 5; i++) {
      stars += '☆';
    }

    return stars;
  };

  // Toggle product selection
  window.theme.compareProducts.toggleProduct = function(productId) {
    const product = window.theme.compareProducts.allProducts.find(p => p.id === productId);
    if (!product) return;

    const existingIndex = window.theme.compareProducts.selectedProducts.findIndex(p => p.id === productId);

    if (existingIndex !== -1) {
      // Remove product
      window.theme.compareProducts.selectedProducts.splice(existingIndex, 1);
    } else {
      // Add product if under limit
      if (window.theme.compareProducts.selectedProducts.length < window.theme.compareProducts.config.maxProducts) {
        window.theme.compareProducts.selectedProducts.push(product);
      } else {
        window.theme.showNotification('{{ 'compare_products.max_products_reached' | t }}', 'warning');
        return;
      }
    }

    window.theme.compareProducts.saveSelection();
    window.theme.compareProducts.render();
  };

  // Clear all selections
  window.theme.compareProducts.clearAll = function() {
    if (window.theme.compareProducts.selectedProducts.length === 0) return;

    if (confirm('{{ 'compare_products.confirm_clear_all' | t }}')) {
      window.theme.compareProducts.selectedProducts = [];
      window.theme.compareProducts.saveSelection();
      window.theme.compareProducts.render();
      document.getElementById('compare-table-container').classList.remove('active');
      window.theme.showNotification('{{ 'compare_products.comparison_cleared' | t }}', 'success');
    }
  };

  // Filter by category
  window.theme.compareProducts.filterByCategory = function(category) {
    window.theme.compareProducts.currentFilter = category;
    window.theme.compareProducts.render();
  };

  // Sort products
  window.theme.compareProducts.sortProducts = function(sortBy) {
    window.theme.compareProducts.currentSort = sortBy;
    window.theme.compareProducts.render();
  };

  // Sort products array
  window.theme.compareProducts.sortProductsArray = function(products, sortBy) {
    const sorted = [...products];

    switch (sortBy) {
      case 'name-asc':
        return sorted.sort((a, b) => a.title.localeCompare(b.title));
      case 'price-asc':
        return sorted.sort((a, b) => a.price - b.price);
      case 'price-desc':
        return sorted.sort((a, b) => b.price - a.price);
      case 'rating-desc':
        return sorted.sort((a, b) => b.rating - a.rating);
      case 'newest':
        return sorted.sort((a, b) => b.id.localeCompare(a.id));
      default:
        return sorted;
    }
  };

  // Show comparison table
  window.theme.compareProducts.showComparison = function() {
    if (window.theme.compareProducts.selectedProducts.length < 2) {
      window.theme.showNotification('{{ 'compare_products.select_products' | t }}', 'warning');
      return;
    }

    const container = document.getElementById('compare-table-container');
    container.classList.add('active');
    container.innerHTML = window.theme.compareProducts.generateComparisonTable();
    container.scrollIntoView({ behavior: 'smooth' });
  };

  // Generate comparison table
  window.theme.compareProducts.generateComparisonTable = function() {
    const products = window.theme.compareProducts.selectedProducts;
    const features = window.theme.compareProducts.config.features;

    let html = `
      <div class="compare-summary">
        <h4>{{ 'compare_products.comparison_summary' | t }}</h4>
        <p>{{ 'compare_products.comparing' | t }} ${products.length} {{ 'compare_products.products' | t }}</p>
      </div>
      <table class="compare-table">
        <thead>
          <tr>
            <th>{{ 'compare_products.feature' | t }}</th>
    `;

    // Product headers
    products.forEach(product => {
      html += `
        <th class="compare-product-cell">
          <img src="${product.image}" alt="${product.title}" class="compare-product-img">
          <div class="compare-product-name">${product.title}</div>
        </th>
      `;
    });

    html += `
          </tr>
        </thead>
        <tbody>
    `;

    // Basic features row
    html += `
      <tr>
        <td><strong>{{ 'compare_products.price' | t }}</strong></td>
    `;
    products.forEach(product => {
      const minPrice = Math.min(...products.map(p => p.price));
      const maxPrice = Math.max(...products.map(p => p.price));
      let differenceClass = '';

      if (product.price === minPrice && minPrice !== maxPrice) {
        differenceClass = 'feature-difference better';
      } else if (product.price === maxPrice && minPrice !== maxPrice) {
        differenceClass = 'feature-difference worse';
      }

      html += `
        <td class="compare-feature-value ${differenceClass}">
          $${product.price}
          ${product.comparePrice ? `<br><span style="text-decoration: line-through; color: #6b7280;">$${product.comparePrice}</span>` : ''}
        </td>
      `;
    });
    html += '</tr>';

    // Rating row
    html += `
      <tr>
        <td><strong>{{ 'compare_products.rating' | t }}</strong></td>
    `;
    products.forEach(product => {
      const maxRating = Math.max(...products.map(p => p.rating));
      let differenceClass = '';

      if (product.rating === maxRating && products.some(p => p.rating !== product.rating)) {
        differenceClass = 'feature-difference better';
      }

      html += `
        <td class="compare-feature-value ${differenceClass}">
          ${window.theme.compareProducts.generateStars(product.rating)} (${product.rating})
        </td>
      `;
    });
    html += '</tr>';

    // Availability row
    html += `
      <tr>
        <td><strong>{{ 'compare_products.availability' | t }}</strong></td>
    `;
    products.forEach(product => {
      html += `
        <td class="compare-feature-value">
          <span class="compare-product-availability ${product.availability === 'in_stock' ? 'availability-in-stock' : 'availability-out-of-stock'}">
            ${product.availability === 'in_stock' ? '{{ 'compare_products.in_stock' | t }}' : '{{ 'compare_products.out_of_stock' | t }}'}
          </span>
        </td>
      `;
    });
    html += '</tr>';

    // Additional features rows
    features.forEach(feature => {
      const featureName = feature.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
      html += `
        <tr>
          <td><strong>${featureName}</strong></td>
      `;

      products.forEach(product => {
        const value = product.features[feature] || 'N/A';
        html += `<td class="compare-feature-value">${value}</td>`;
      });

      html += '</tr>';
    });

    // Action buttons row
    html += `
      <tr>
        <td><strong>{{ 'general.actions' | t }}</strong></td>
    `;

    products.forEach(product => {
      html += `
        <td class="compare-feature-value">
          <button class="compare-btn btn-add-to-cart" onclick="window.theme.compareProducts.addToCart('${product.id}')" style="margin: 0.25rem; padding: 0.5rem 1rem;">
            {{ 'compare_products.add_to_cart' | t }}
          </button>
          <button class="compare-btn" onclick="window.theme.compareProducts.viewDetails('${product.id}')" style="margin: 0.25rem; padding: 0.5rem 1rem; background: #f3f4f6; color: #374151;">
            {{ 'compare_products.view_details' | t }}
          </button>
        </td>
      `;
    });

    html += `
        </tr>
      </tbody>
    </table>
    `;

    // Add recommendation
    if (products.length >= 2) {
      html += window.theme.compareProducts.generateRecommendation(products);
    }

    return html;
  };

  // Generate recommendation
  window.theme.compareProducts.generateRecommendation = function(products) {
    let recommendation = '';
    let reason = '';

    // Find best value (lowest price with good rating)
    const bestValue = products.reduce((best, current) => {
      const bestScore = best.rating / best.price;
      const currentScore = current.rating / current.price;
      return currentScore > bestScore ? current : best;
    });

    // Find premium choice (highest price)
    const premiumChoice = products.reduce((best, current) =>
      current.price > best.price ? current : best
    );

    // Find most popular (highest rating)
    const mostPopular = products.reduce((best, current) =>
      current.rating > best.rating ? current : best
    );

    recommendation = `
      <div class="compare-recommendation">
        <h4>{{ 'compare_products.recommendation' | t }}</h4>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-top: 1rem;">
          <div>
            <strong>{{ 'compare_products.best_value' | t }}:</strong><br>
            ${bestValue.title}<br>
            <span style="color: #059669;">$${bestValue.price} • Rating: ${bestValue.rating}</span>
          </div>
          <div>
            <strong>{{ 'compare_products.premium_choice' | t }}:</strong><br>
            ${premiumChoice.title}<br>
            <span style="color: #7c2d12;">$${premiumChoice.price} • Rating: ${premiumChoice.rating}</span>
          </div>
          <div>
            <strong>{{ 'compare_products.most_popular' | t }}:</strong><br>
            ${mostPopular.title}<br>
            <span style="color: #1e40af;">Rating: ${mostPopular.rating} • ${mostPopular.reviews} reviews</span>
          </div>
        </div>
      </div>
    `;

    return recommendation;
  };

  // Add to cart
  window.theme.compareProducts.addToCart = function(productId) {
    const product = window.theme.compareProducts.selectedProducts.find(p => p.id === productId);
    if (product) {
      // Track comparison interaction
      window.theme.compareProducts.trackInteraction('add_to_cart_from_compare', product);

      // Add to cart logic
      if (window.theme.cart && typeof window.theme.cart.addItem === 'function') {
        window.theme.cart.addItem({
          id: productId,
          title: product.title,
          price: product.price,
          quantity: 1
        });
      } else {
        window.theme.showNotification(`${product.title} added to cart`, 'success');
      }
    }
  };

  // View details
  window.theme.compareProducts.viewDetails = function(productId) {
    const product = window.theme.compareProducts.selectedProducts.find(p => p.id === productId);
    if (product) {
      // Track comparison interaction
      window.theme.compareProducts.trackInteraction('view_details_from_compare', product);

      // Navigate to product page (mock implementation)
      window.theme.showNotification(`Viewing details for ${product.title}`, 'info');
    }
  };

  // Track user interaction
  window.theme.compareProducts.trackInteraction = function(action, product) {
    console.log('Compare Interaction:', action, product);
    // In real implementation, this would send to analytics
  };

  // Initialize when DOM is loaded
  document.addEventListener('DOMContentLoaded', function() {
    if (document.getElementById('compare-products')) {
      window.theme.compareProducts.init();
    }
  });
</script>