<style>
  .compare-products {
    margin: 2rem 0;
    padding: 1.5rem;
    background: linear-gradient(135deg, #fef3f3 0%, #fefce8 100%);
    border-radius: 0.75rem;
    border: 2px dashed #dc2626;
  }

  .compare-products.dark-theme {
    background: linear-gradient(135deg, #451a03 0%, #78350f 100%);
    color: white;
    border-color: #fbbf24;
  }

  .compare-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .compare-header h3 {
    font-size: 1.5rem;
    font-weight: 700;
    color: #dc2626;
    margin-bottom: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .compare-header .tamil-subtitle {
    font-size: 0.875rem;
    color: #7c1e1e;
    font-weight: 500;
  }

  .compare-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .compare-filter {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .compare-filter select {
    padding: 0.5rem 1rem;
    border: 2px solid #e5e7eb;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    background: white;
  }

  .compare-actions {
    display: flex;
    gap: 0.5rem;
  }

  .compare-btn {
    padding: 0.5rem 1rem;
    border: none;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .btn-clear-all {
    background: #ef4444;
    color: white;
  }

  .btn-clear-all:hover {
    background: #dc2626;
  }

  .btn-compare-now {
    background: #dc2626;
    color: white;
  }

  .btn-compare-now:hover:not(:disabled) {
    background: #b91c1c;
  }

  .btn-compare-now:disabled {
    background: #9ca3af;
    cursor: not-allowed;
  }

  .compare-products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .compare-product-card {
    background: white;
    border-radius: 0.5rem;
    border: 2px solid #e5e7eb;
    padding: 1rem;
    cursor: pointer;
    transition: all 0.2s ease;
    position: relative;
  }

  .compare-product-card:hover {
    border-color: #dc2626;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(220, 38, 38, 0.15);
  }

  .compare-product-card.selected {
    border-color: #dc2626;
    background: #fef2f2;
  }

  .compare-product-card.selected::before {
    content: '✓';
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    width: 1.5rem;
    height: 1.5rem;
    background: #dc2626;
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: 0.875rem;
  }

  .compare-product-image {
    width: 100%;
    height: 120px;
    object-fit: cover;
    border-radius: 0.25rem;
    margin-bottom: 0.75rem;
  }

  .compare-product-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: #1f2937;
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  .compare-product-price {
    font-size: 1rem;
    font-weight: 700;
    color: #dc2626;
    margin-bottom: 0.5rem;
  }

  .compare-product-price .compare-at {
    font-size: 0.75rem;
    color: #6b7280;
    text-decoration: line-through;
    margin-left: 0.25rem;
  }

  .compare-product-rating {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-bottom: 0.5rem;
  }

  .compare-rating-stars {
    color: #fbbf24;
  }

  .compare-rating-value {
    font-size: 0.75rem;
    color: #6b7280;
  }

  .compare-product-availability {
    font-size: 0.75rem;
    padding: 0.25rem 0.5rem;
    border-radius: 9999px;
    font-weight: 500;
  }

  .availability-in-stock {
    background: #d1fae5;
    color: #065f46;
  }

  .availability-out-of-stock {
    background: #fee2e2;
    color: #991b1b;
  }

  .compare-add-btn {
    width: 100%;
    padding: 0.5rem;
    background: #f3f4f6;
    color: #374151;
    border: 1px solid #d1d5db;
    border-radius: 0.25rem;
    font-size: 0.75rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .compare-add-btn:hover {
    background: #e5e7eb;
  }

  .compare-add-btn.added {
    background: #dc2626;
    color: white;
    border-color: #dc2626;
  }

  .compare-table-container {
    background: white;
    border-radius: 0.75rem;
    overflow: hidden;
    margin-top: 2rem;
    display: none;
  }

  .compare-table-container.active {
    display: block;
  }

  .compare-table {
    width: 100%;
    border-collapse: collapse;
  }

  .compare-table th,
  .compare-table td {
    padding: 1rem;
    text-align: left;
    border-bottom: 1px solid #e5e7eb;
  }

  .compare-table th {
    background: #f9fafb;
    font-weight: 600;
    color: #374151;
    position: sticky;
    top: 0;
  }

  .compare-table tr:hover {
    background: #f9fafb;
  }

  .compare-product-cell {
    text-align: center;
    vertical-align: top;
  }

  .compare-product-img {
    width: 80px;
    height: 80px;
    object-fit: cover;
    border-radius: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .compare-product-name {
    font-weight: 600;
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  .compare-feature-value {
    text-align: center;
    padding: 0.75rem;
  }

  .feature-difference {
    position: relative;
  }

  .feature-difference.better::after {
    content: '↑';
    color: #10b981;
    font-weight: bold;
    margin-left: 0.25rem;
  }

  .feature-difference.worse::after {
    content: '↓';
    color: #ef4444;
    font-weight: bold;
    margin-left: 0.25rem;
  }

  .compare-empty-state {
    text-align: center;
    padding: 3rem;
    color: #6b7280;
  }

  .compare-empty-state svg {
    width: 4rem;
    height: 4rem;
    margin: 0 auto 1rem;
    color: #d1d5db;
  }

  .compare-summary {
    background: #f0f9ff;
    border: 1px solid #0ea5e9;
    border-radius: 0.5rem;
    padding: 1rem;
    margin-bottom: 1rem;
  }

  .compare-summary h4 {
    color: #0369a1;
    margin-bottom: 0.5rem;
  }

  .compare-recommendation {
    background: #f0fdf4;
    border: 1px solid #22c55e;
    border-radius: 0.5rem;
    padding: 1rem;
    margin-top: 1rem;
  }

  .compare-recommendation h4 {
    color: #166534;
    margin-bottom: 0.5rem;
  }

  .compare-loading {
    text-align: center;
    padding: 2rem;
    color: #6b7280;
  }

  .loading-spinner {
    width: 2rem;
    height: 2rem;
    border: 3px solid rgba(220, 38, 38, 0.3);
    border-top: 3px solid #dc2626;
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin: 0 auto 1rem;
  }

  .compare-tooltip {
    position: relative;
    display: inline-block;
  }

  .compare-tooltip .tooltip-text {
    visibility: hidden;
    width: 200px;
    background-color: #1f2937;
    color: white;
    text-align: center;
    border-radius: 0.5rem;
    padding: 0.5rem;
    position: absolute;
    z-index: 1;
    bottom: 125%;
    left: 50%;
    margin-left: -100px;
    opacity: 0;
    transition: opacity 0.3s;
    font-size: 0.75rem;
  }

  .compare-tooltip:hover .tooltip-text {
    visibility: visible;
    opacity: 1;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  @media (max-width: 768px) {
    .compare-products {
      margin: 1.5rem 0;
      padding: 1rem;
    }

    .compare-header h3 {
      font-size: 1.25rem;
    }

    .compare-controls {
      flex-direction: column;
      align-items: stretch;
    }

    .compare-products-grid {
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      gap: 0.75rem;
    }

    .compare-table-container {
      overflow-x: auto;
    }

    .compare-table {
      min-width: 600px;
    }

    .compare-table th,
    .compare-table td {
      padding: 0.5rem;
      font-size: 0.875rem;
    }
  }

  @media (max-width: 480px) {
    .compare-products-grid {
      grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    }

    .compare-product-image {
      height: 100px;
    }

    .compare-product-title {
      font-size: 0.75rem;
    }
  }
</style>

<div class="compare-products" id="compare-products">
  <div class="compare-header">
    <h3>
      <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
        <path d="M5 4a1 1 0 00-2 0v7.268a2 2 0 000 3.464V16a1 1 0 102 0v-1.268a2 2 0 000-3.464V4zM11 4a1 1 0 10-2 0v1.268a2 2 0 000 3.464V16a1 1 0 102 0V8.732a2 2 0 000-3.464V4zM16 3a1 1 0 011 1v7.268a2 2 0 010 3.464V16a1 1 0 11-2 0v-1.268a2 2 0 010-3.464V4a1 1 0 011-1z"/>
      </svg>
      {{ 'compare_products.title' | t }}
    </h3>
    <div class="tamil-subtitle">{{ 'compare_products.subtitle_tamil' | t }}</div>
  </div>

  <!-- Compare Controls -->
  <div class="compare-controls">
    <div class="compare-filter">
      <label for="category-filter">{{ 'compare_products.select_category' | t }}:</label>
      <select id="category-filter" onchange="window.theme.compareProducts.filterByCategory(this.value)">
        <option value="all">{{ 'compare_products.all_categories' | t }}</option>
        <option value="sarees">Sarees</option>
        <option value="mens-wear">Men's Wear</option>
        <option value="womens-wear">Women's Wear</option>
        <option value="accessories">Accessories</option>
        <option value="jewelry">Jewelry</option>
      </select>

      <label for="sort-compare">{{ 'compare_products.sort_by' | t }}:</label>
      <select id="sort-compare" onchange="window.theme.compareProducts.sortProducts(this.value)">
        <option value="name-asc">{{ 'compare_products.name_a_z' | t }}</option>
        <option value="price-asc">{{ 'compare_products.price_low_high' | t }}</option>
        <option value="price-desc">{{ 'compare_products.price_high_low' | t }}</option>
        <option value="rating-desc">{{ 'compare_products.rating_high_low' | t }}</option>
        <option value="newest">{{ 'compare_products.newest_first' | t }}</option>
      </select>
    </div>

    <div class="compare-actions">
      <button class="compare-btn btn-clear-all" onclick="window.theme.compareProducts.clearAll()">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"/>
        </svg>
        {{ 'compare_products.clear_all' | t }}
      </button>
      <button class="compare-btn btn-compare-now" id="compare-now-btn" onclick="window.theme.compareProducts.showComparison()" disabled>
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
          <path d="M5 4a1 1 0 00-2 0v7.268a2 2 0 000 3.464V16a1 1 0 102 0v-1.268a2 2 0 000-3.464V4zM11 4a1 1 0 10-2 0v1.268a2 2 0 000 3.464V16a1 1 0 102 0V8.732a2 2 0 000-3.464V4zM16 3a1 1 0 011 1v7.268a2 2 0 010 3.464V16a1 1 0 11-2 0v-1.268a2 2 0 010-3.464V4a1 1 0 011-1z"/>
        </svg>
        {{ 'compare_products.compare_now' | t }}
      </button>
    </div>
  </div>

  <!-- Loading State -->
  <div class="compare-loading" id="compare-loading" style="display: none;">
    <div class="loading-spinner"></div>
    {{ 'compare_products.loading' | t }}
  </div>

  <!-- Empty State -->
  <div class="compare-empty-state" id="compare-empty">
    <svg class="w-16 h-16 mx-auto mb-4 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
      <path d="M5 4a1 1 0 00-2 0v7.268a2 2 0 000 3.464V16a1 1 0 102 0v-1.268a2 2 0 000-3.464V4zM11 4a1 1 0 10-2 0v1.268a2 2 0 000 3.464V16a1 1 0 102 0V8.732a2 2 0 000-3.464V4zM16 3a1 1 0 011 1v7.268a2 2 0 010 3.464V16a1 1 0 11-2 0v-1.268a2 2 0 010-3.464V4a1 1 0 011-1z"/>
    </svg>
    <h4 class="text-lg font-semibold mb-2">{{ 'compare_products.no_comparison' | t }}</h4>
    <p class="text-sm mb-4">{{ 'compare_products.select_products' | t }}</p>
    <p class="text-xs text-gray-500">{{ 'compare_products.help_text' | t }}</p>
  </div>

  <!-- Products Grid -->
  <div class="compare-products-grid" id="compare-products-grid" style="display: none;">
    <!-- Products will be loaded here -->
  </div>

  <!-- Comparison Table -->
  <div class="compare-table-container" id="compare-table-container">
    <!-- Comparison table will be generated here -->
  </div>

  <!-- Privacy Notice -->
  <div class="text-xs text-gray-500 mt-4 text-center">
    {{ 'compare_products.privacy_notice' | t }}
  </div>
</div>

<script>
  // Compare Products System
  window.theme = window.theme || {};
  window.theme.compareProducts = window.theme.compareProducts || {};

  // Configuration
  window.theme.compareProducts.config = {
    maxProducts: 4,
    storageKey: 'ravan-compare-products',
    features: [
      'price', 'rating', 'availability', 'material', 'size', 'color',
      'care_instructions', 'origin', 'sustainability', 'cultural_significance'
    ]
  };

  // State
  window.theme.compareProducts.selectedProducts = [];
  window.theme.compareProducts.allProducts = [];
  window.theme.compareProducts.currentFilter = 'all';
  window.theme.compareProducts.currentSort = 'name-asc';

  // Mock product database
  window.theme.compareProducts.productDatabase = [
    {
      id: 'kanjivaram-saree',
      title: 'Traditional Kanjivaram Saree',
      price: 299.99,
      comparePrice: 399.99,
      rating: 4.8,
