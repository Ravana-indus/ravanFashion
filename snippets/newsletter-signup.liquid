<div class="newsletter-form">
  <form class="space-y-4" onsubmit="window.theme.handleNewsletterSubmit(event)">
    <div>
      <label for="email" class="block text-sm font-medium mb-2">
        {% render 'translation', key: 'forms.email', default: 'Email Address' %}
      </label>
      <input
        type="email"
        id="email"
        name="email"
        required
        placeholder="{% render 'translation', key: 'newsletter.placeholder', default: 'your@email.com' %}"
        class="w-full px-4 py-2 rounded-md border border-gray-300 focus:outline-none focus:ring-2 focus:ring-gold focus:border-transparent text-charcoal-black"
        aria-label="{% render 'translation', key: 'forms.email', default: 'Email Address' %}"
      >
    </div>
    <button
      type="submit"
      class="w-full bg-gold text-charcoal-black font-medium py-2 px-4 rounded-md hover:bg-yellow-500 transition-colors"
    >
      {% render 'translation', key: 'newsletter.button', default: 'Subscribe' %}
    </button>
  </form>
  <p class="text-xs text-gray-300 mt-2">
    {% render 'translation', key: 'newsletter.description', default: 'Join our community for exclusive offers and cultural updates.' %}
  </p>
</div>