{%- comment -%}
AR Try-On Snippet
Augmented reality product try-on feature with camera integration and virtual fitting
{%- endcomment -%}

<div class="ar-try-on" data-section-id="{{ section.id }}" data-product-id="{{ product.id }}">
  <!-- AR Try-On Container -->
  <div class="ar-container relative bg-gray-50 rounded-lg overflow-hidden" role="region" aria-label="{{ 'products.ar_try_on.title' | t }}">

    <!-- AR Display Area -->
    <div class="ar-display relative aspect-[4/3] bg-black" id="ar-display">
      <!-- Camera Feed -->
      <video
        id="camera-feed"
        class="camera-feed w-full h-full object-cover"
        autoplay
        playsinline
        muted
        aria-label="{{ 'products.ar_try_on.camera_view' | t }}"
      ></video>

      <!-- AR Overlay Canvas -->
      <canvas
        id="ar-canvas"
        class="ar-overlay absolute inset-0 w-full h-full pointer-events-none"
        aria-hidden="true"
      ></canvas>

      <!-- Product AR Model -->
      <div class="ar-model-container absolute inset-0 pointer-events-none" id="ar-model-container">
        <!-- AR model will be loaded here -->
      </div>

      <!-- AR Controls Overlay -->
      <div class="ar-controls-overlay absolute inset-0 pointer-events-none">
        <!-- Top Controls -->
        <div class="top-controls absolute top-4 left-4 right-4 flex justify-between items-start pointer-events-auto">
          <button
            class="close-ar-btn bg-black bg-opacity-60 text-white p-3 rounded-full hover:bg-opacity-80 transition-all"
            aria-label="{{ 'products.ar_try_on.close_ar' | t }}"
            data-action="close-ar"
          >
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"/>
            </svg>
          </button>

          <div class="ar-info flex gap-3">
            <button
              class="help-btn bg-black bg-opacity-60 text-white p-3 rounded-full hover:bg-opacity-80 transition-all"
              aria-label="{{ 'products.ar_try_on.help' | t }}"
              data-action="show-help"
            >
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1 1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z"/>
              </svg>
            </button>

            <button
              class="settings-btn bg-black bg-opacity-60 text-white p-3 rounded-full hover:bg-opacity-80 transition-all"
              aria-label="{{ 'products.ar_try_on.settings' | t }}"
              data-action="show-settings"
            >
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z"/>
              </svg>
            </button>
          </div>
        </div>

        <!-- Bottom Controls -->
        <div class="bottom-controls absolute bottom-4 left-4 right-4 pointer-events-auto">
          <!-- Size Selector -->
          <div class="size-selector bg-black bg-opacity-60 rounded-lg p-3 mb-3">
            <label class="text-white text-sm font-medium mb-2 block">{{ 'products.ar_try_on.select_size' | t }}</label>
            <div class="size-options flex gap-2">
              {%- for variant in product.variants -%}
                <button
                  class="size-option px-3 py-1 rounded bg-white bg-opacity-20 text-white text-sm hover:bg-opacity-30 transition-all"
                  data-size="{{ variant.title }}"
                  data-variant-id="{{ variant.id }}"
                  {%- if forloop.first %}class="active"{% endif %}
                >
                  {{ variant.title }}
                </button>
              {%- endfor -%}
            </div>
          </div>

          <!-- Color Selector -->
          <div class="color-selector bg-black bg-opacity-60 rounded-lg p-3 mb-3">
            <label class="text-white text-sm font-medium mb-2 block">{{ 'products.ar_try_on.select_color' | t }}</label>
            <div class="color-options flex gap-2">
              {%- for color in product.options_by_name['Color'].values -%}
                <button
                  class="color-option w-8 h-8 rounded-full border-2 border-white hover:scale-110 transition-transform"
                  style="background-color: {{ color | downcase | replace: ' ', '-' }};"
                  data-color="{{ color }}"
                  title="{{ color }}"
                  {%- if forloop.first %}class="active"{% endif %}
                ></button>
              {%- endfor -%}
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="action-buttons flex gap-3">
            <button
              class="capture-btn flex-1 bg-yellow-600 text-white py-3 px-6 rounded-lg hover:bg-yellow-700 transition-colors flex items-center justify-center gap-2"
              data-action="capture-photo"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M4 5a2 2 0 00-2 2v8a2 2 0 002 2h12a2 2 0 002-2V7a2 2 0 00-2-2h-1.586a1 1 0 01-.707-.293l-1.121-1.121A2 2 0 0011.172 3H8.828a2 2 0 00-1.414.586L6.293 4.707A1 1 0 015.586 5H4zm6 9a3 3 0 100-6 3 3 0 000 6z"/>
              </svg>
              {{ 'products.ar_try_on.capture_photo' | t }}
            </button>

            <button
              class="record-btn flex-1 bg-red-600 text-white py-3 px-6 rounded-lg hover:bg-red-700 transition-colors flex items-center justify-center gap-2"
              data-action="toggle-recording"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM7 9a1 1 0 000 2h6a1 1 0 100-2H7z"/>
              </svg>
              {{ 'products.ar_try_on.record_video' | t }}
            </button>

            <button
              class="share-btn flex-1 bg-blue-600 text-white py-3 px-6 rounded-lg hover:bg-blue-700 transition-colors flex items-center justify-center gap-2"
              data-action="share-ar"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path d="M15 8a3 3 0 10-2.977-2.63l-4.94 2.47a3 3 0 100 4.319l4.94 2.47a3 3 0 10.895-1.789l-4.94-2.47a3.027 3.027 0 000-.74l4.94-2.47C13.456 7.68 14.19 8 15 8z"/>
              </svg>
              {{ 'products.ar_try_on.share' | t }}
            </button>
          </div>
        </div>

        <!-- Side Controls -->
        <div class="side-controls absolute right-4 top-1/2 transform -translate-y-1/2 flex flex-col gap-3 pointer-events-auto">
          <button
            class="zoom-in-btn bg-black bg-opacity-60 text-white p-3 rounded-full hover:bg-opacity-80 transition-all"
            aria-label="{{ 'products.ar_try_on.zoom_in' | t }}"
            data-action="zoom-in"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z"/>
              <path fill-rule="evenodd" d="M8 5a1 1 0 011 1v1h1a1 1 0 110 2H9v1a1 1 0 11-2 0V9H6a1 1 0 110-2h1V6a1 1 0 011-1z"/>
            </svg>
          </button>

          <button
            class="zoom-out-btn bg-black bg-opacity-60 text-white p-3 rounded-full hover:bg-opacity-80 transition-all"
            aria-label="{{ 'products.ar_try_on.zoom_out' | t }}"
            data-action="zoom-out"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z"/>
              <path fill-rule="evenodd" d="M5 8a1 1 0 011-1h4a1 1 0 110 2H6a1 1 0 01-1-1z"/>
            </svg>
          </button>

          <button
            class="reset-btn bg-black bg-opacity-60 text-white p-3 rounded-full hover:bg-opacity-80 transition-all"
            aria-label="{{ 'products.ar_try_on.reset_view' | t }}"
            data-action="reset-view"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M4 2a1 1 0 011 1v2.101a7.002 7.002 0 0111.601 2.566 1 1 0 11-1.885.666A5.002 5.002 0 005.999 7H9a1 1 0 010 2H4a1 1 0 01-1-1V3a1 1 0 011-1zm.008 9.057a1 1 0 011.276.61A5.002 5.002 0 0014.001 13H11a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0v-2.101a7.002 7.002 0 01-11.601-2.566 1 1 0 01.61-1.276z"/>
            </svg>
          </button>

          <button
            class="rotate-btn bg-black bg-opacity-60 text-white p-3 rounded-full hover:bg-opacity-80 transition-all"
            aria-label="{{ 'products.ar_try_on.rotate_product' | t }}"
            data-action="rotate-product"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M4 2a1 1 0 011 1v2.101a7.002 7.002 0 0111.601 2.566 1 1 0 11-1.885.666A5.002 5.002 0 005.999 7H9a1 1 0 010 2H4a1 1 0 01-1-1V3a1 1 0 011-1zm.008 9.057a1 1 0 011.276.61A5.002 5.002 0 0014.001 13H11a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0v-2.101a7.002 7.002 0 01-11.601-2.566 1 1 0 01.61-1.276z"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- AR Status Indicator -->
      <div class="ar-status absolute top-4 left-1/2 transform -translate-x-1/2 bg-black bg-opacity-60 text-white px-4 py-2 rounded-full text-sm flex items-center gap-2">
        <div class="status-dot w-2 h-2 bg-green-400 rounded-full animate-pulse"></div>
        <span id="ar-status-text">{{ 'products.ar_try_on.ar_active' | t }}</span>
      </div>

      <!-- Loading Indicator -->
      <div class="ar-loading absolute inset-0 bg-black bg-opacity-80 flex items-center justify-center hidden" id="ar-loading">
        <div class="text-center text-white">
          <div class="animate-spin rounded-full h-16 w-16 border-b-2 border-yellow-400 mx-auto mb-4"></div>
          <p class="text-lg">{{ 'products.ar_try_on.loading_ar' | t }}</p>
          <p class="text-sm opacity-75">{{ 'products.ar_try_on.please_wait' | t }}</p>
        </div>
      </div>

      <!-- Camera Permission Modal -->
      <div class="camera-permission-modal fixed inset-0 bg-black bg-opacity-80 flex items-center justify-center z-50 hidden" id="camera-permission-modal">
        <div class="bg-white rounded-lg p-6 max-w-md mx-4">
          <h3 class="text-xl font-semibold mb-4">{{ 'products.ar_try_on.camera_permission' | t }}</h3>
          <p class="text-gray-600 mb-6">{{ 'products.ar_try_on.camera_permission_desc' | t }}</p>
          <div class="flex gap-3">
            <button class="allow-camera-btn flex-1 bg-yellow-600 text-white py-2 px-4 rounded-lg hover:bg-yellow-700 transition-colors" data-action="allow-camera">
              {{ 'products.ar_try_on.allow_camera' | t }}
            </button>
            <button class="deny-camera-btn flex-1 bg-gray-300 text-gray-700 py-2 px-4 rounded-lg hover:bg-gray-400 transition-colors" data-action="deny-camera">
              {{ 'products.ar_try_on.deny_camera' | t }}
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- AR Instructions -->
    <div class="ar-instructions mt-6 bg-blue-50 rounded-lg p-6">
      <h3 class="text-lg font-semibold text-gray-900 mb-4">{{ 'products.ar_try_on.how_to_use' | t }}</h3>
      <div class="instructions-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="instruction-item text-center">
          <div class="instruction-icon w-12 h-12 bg-yellow-600 text-white rounded-full flex items-center justify-center mx-auto mb-2">
            <span class="text-lg font-bold">1</span>
          </div>
          <h4 class="font-medium text-gray-900 mb-1">{{ 'products.ar_try_on.step_1' | t }}</h4>
          <p class="text-sm text-gray-600">{{ 'products.ar_try_on.step_1_desc' | t }}</p>
        </div>
        <div class="instruction-item text-center">
          <div class="instruction-icon w-12 h-12 bg-yellow-600 text-white rounded-full flex items-center justify-center mx-auto mb-2">
            <span class="text-lg font-bold">2</span>
          </div>
          <h4 class="font-medium text-gray-900 mb-1">{{ 'products.ar_try_on.step_2' | t }}</h4>
          <p class="text-sm text-gray-600">{{ 'products.ar_try_on.step_2_desc' | t }}</p>
        </div>
        <div class="instruction-item text-center">
          <div class="instruction-icon w-12 h-12 bg-yellow-600 text-white rounded-full flex items-center justify-center mx-auto mb-2">
            <span class="text-lg font-bold">3</span>
          </div>
          <h4 class="font-medium text-gray-900 mb-1">{{ 'products.ar_try_on.step_3' | t }}</h4>
          <p class="text-sm text-gray-600">{{ 'products.ar_try_on.step_3_desc' | t }}</p>
        </div>
        <div class="instruction-item text-center">
          <div class="instruction-icon w-12 h-12 bg-yellow-600 text-white rounded-full flex items-center justify-center mx-auto mb-2">
            <span class="text-lg font-bold">4</span>
          </div>
          <h4 class="font-medium text-gray-900 mb-1">{{ 'products.ar_try_on.step_4' | t }}</h4>
          <p class="text-sm text-gray-600">{{ 'products.ar_try_on.step_4_desc' | t }}</p>
        </div>
      </div>
    </div>

    <!-- AR Settings Panel -->
    <div class="ar-settings-panel mt-6 bg-white rounded-lg border border-gray-200 p-6 hidden" id="ar-settings-panel">
      <h3 class="text-lg font-semibold text-gray-900 mb-4">{{ 'products.ar_try_on.ar_settings' | t }}</h3>

      <div class="settings-grid grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- AR Quality -->
        <div class="setting-group">
          <label class="block text-sm font-medium text-gray-700 mb-2">{{ 'products.ar_try_on.ar_quality' | t }}</label>
          <select id="ar-quality" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-yellow-400 focus:border-transparent">
            <option value="low">{{ 'products.ar_try_on.low_quality' | t }}</option>
            <option value="medium" selected>{{ 'products.ar_try_on.medium_quality' | t }}</option>
            <option value="high">{{ 'products.ar_try_on.high_quality' | t }}</option>
          </select>
        </div>

        <!-- Lighting Mode -->
        <div class="setting-group">
          <label class="block text-sm font-medium text-gray-700 mb-2">{{ 'products.ar_try_on.lighting_mode' | t }}</label>
          <select id="lighting-mode" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-yellow-400 focus:border-transparent">
            <option value="auto">{{ 'products.ar_try_on.auto_lighting' | t }}</option>
            <option value="bright">{{ 'products.ar_try_on.bright_lighting' | t }}</option>
            <option value="dark">{{ 'products.ar_try_on.dark_lighting' | t }}</option>
          </select>
        </div>

        <!-- Body Tracking -->
        <div class="setting-group">
          <label class="block text-sm font-medium text-gray-700 mb-2">{{ 'products.ar_try_on.body_tracking' | t }}</label>
          <div class="toggle-switch">
            <input type="checkbox" id="body-tracking-toggle" class="sr-only" checked>
            <label for="body-tracking-toggle" class="flex items-center cursor-pointer">
              <div class="relative">
                <div class="block bg-gray-600 w-14 h-8 rounded-full"></div>
                <div class="dot absolute left-1 top-1 bg-white w-6 h-6 rounded-full transition"></div>
              </div>
              <div class="ml-3 text-gray-700 font-medium">{{ 'products.ar_try_on.enabled' | t }}</div>
            </label>
          </div>
        </div>

        <!-- Motion Stabilization -->
        <div class="setting-group">
          <label class="block text-sm font-medium text-gray-700 mb-2">{{ 'products.ar_try_on.motion_stabilization' | t }}</label>
          <div class="toggle-switch">
            <input type="checkbox" id="motion-stabilization-toggle" class="sr-only" checked>
            <label for="motion-stabilization-toggle" class="flex items-center cursor-pointer">
              <div class="relative">
                <div class="block bg-gray-600 w-14 h-8 rounded-full"></div>
                <div class="dot absolute left-1 top-1 bg-white w-6 h-6 rounded-full transition"></div>
              </div>
              <div class="ml-3 text-gray-700 font-medium">{{ 'products.ar_try_on.enabled' | t }}</div>
            </label>
          </div>
        </div>

        <!-- AR Model Type -->
        <div class="setting-group">
          <label class="block text-sm font-medium text-gray-700 mb-2">{{ 'products.ar_try_on.ar_model_type' | t }}</label>
          <select id="ar-model-type" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-yellow-400 focus:border-transparent">
            <option value="standard">{{ 'products.ar_try_on.standard_model' | t }}</option>
            <option value="detailed">{{ 'products.ar_try_on.detailed_model' | t }}</option>
            <option value="lightweight">{{ 'products.ar_try_on.lightweight_model' | t }}</option>
          </select>
        </div>

        <!-- Show Measurements -->
        <div class="setting-group">
          <label class="block text-sm font-medium text-gray-700 mb-2">{{ 'products.ar_try_on.show_measurements' | t }}</label>
          <div class="toggle-switch">
            <input type="checkbox" id="measurements-toggle" class="sr-only">
            <label for="measurements-toggle" class="flex items-center cursor-pointer">
              <div class="relative">
                <div class="block bg-gray-600 w-14 h-8 rounded-full"></div>
                <div class="dot absolute left-1 top-1 bg-white w-6 h-6 rounded-full transition"></div>
              </div>
              <div class="ml-3 text-gray-700 font-medium">{{ 'products.ar_try_on.enabled' | t }}</div>
            </label>
          </div>
        </div>
      </div>

      <div class="settings-actions mt-6 flex gap-3">
        <button class="save-settings-btn px-6 py-2 bg-yellow-600 text-white rounded-lg hover:bg-yellow-700 transition-colors" data-action="save-settings">
          {{ 'products.ar_try_on.save_settings' | t }}
        </button>
        <button class="reset-settings-btn px-6 py-2 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400 transition-colors" data-action="reset-settings">
          {{ 'products.ar_try_on.reset_settings' | t }}
        </button>
        <button class="close-settings-btn px-6 py-2 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400 transition-colors" data-action="close-settings">
          {{ 'products.ar_try_on.close' | t }}
        </button>
      </div>
    </div>

    <!-- Captured Photos Gallery -->
    <div class="captured-photos mt-6 bg-gray-100 rounded-lg p-6">
      <h3 class="text-lg font-semibold text-gray-900 mb-4">{{ 'products.ar_try_on.your_try_ons' | t }}</h3>
      <div class="photos-grid grid grid-cols-2 md:grid-cols-4 gap-4" id="captured-photos-grid">
        <!-- Captured photos will be displayed here -->
      </div>
    </div>
  </div>
</div>

<style>
/* AR Try-On Styles */
.ar-container {
  max-width: 1200px;
  margin: 0 auto;
}

.ar-display {
  position: relative;
  overflow: hidden;
}

.camera-feed {
  transform: scaleX(-1); /* Mirror the camera feed */
}

.ar-canvas {
  z-index: 10;
}

.ar-model-container {
  z-index: 5;
}

.size-option.active {
  background-color: #d4af37;
  color: white;
}

.color-option.active {
  border-color: #6a1b1b !important;
  border-width: 3px;
}

.toggle-switch input:checked + label .dot {
  transform: translateX(100%);
  background-color: #d4af37;
}

.toggle-switch input:checked + label .block {
  background-color: #d4af37;
}

.captured-photo {
  position: relative;
  aspect-square;
  border-radius: 8px;
  overflow: hidden;
  cursor: pointer;
  transition: transform 0.3s ease;
}

.captured-photo:hover {
  transform: scale(1.05);
}

.captured-photo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.photo-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);
  color: white;
  padding: 8px;
  font-size: 0.75rem;
}

.recording-indicator {
  position: absolute;
  top: 20px;
  right: 20px;
  background: red;
  color: white;
  padding: 8px 16px;
  border-radius: 20px;
  font-size: 0.875rem;
  display: flex;
  align-items: center;
  gap: 8px;
  animation: pulse 1s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

/* Responsive Design */
@media (max-width: 768px) {
  .ar-controls-overlay {
    transform: scale(0.9);
    transform-origin: bottom center;
  }

  .side-controls {
    right: 8px;
  }

  .bottom-controls {
    left: 8px;
    right: 8px;
    bottom: 8px;
  }

  .action-buttons {
    flex-direction: column;
  }

  .instructions-grid {
    grid-template-columns: 1fr;
  }

  .settings-grid {
    grid-template-columns: 1fr;
  }
}
</style>

<script>
// AR Try-On JavaScript
document.addEventListener('DOMContentLoaded', function() {
  class ARTryOn {
    constructor(container) {
      this.container = container;
      this.cameraFeed = container.querySelector('#camera-feed');
      this.arCanvas = container.querySelector('#ar-canvas');
      this.ctx = this.arCanvas.getContext('2d');
      this.arModelContainer = container.querySelector('#ar-model-container');
      this.isActive = false;
      this.isRecording = false;
      this.currentSize = '';
      this.currentColor = '';
      this.arScale = 1;
      this.arRotation = 0;
      this.capturedPhotos = [];
      this.settings = {
        arQuality: 'medium',
        lightingMode: 'auto',
        bodyTracking: true,
        motionStabilization: true,
        arModelType: 'standard',
        showMeasurements: false
      };
      this.mediaRecorder = null;
      this.recordedChunks = [];

      this.init();
    }

    async init() {
      this.setupCanvas();
      this.setupEventListeners();
      this.loadSettings();
      this.loadCapturedPhotos();
      this.checkARSupport();
    }

    setupCanvas() {
      const rect = this.arCanvas.getBoundingClientRect();
      this.arCanvas.width = rect.width * window.devicePixelRatio;
      this.arCanvas.height = rect.height * window.devicePixelRatio;
      this.ctx.scale(window.devicePixelRatio, window.devicePixelRatio);
    }

    async checkARSupport() {
      const hasCamera = await this.checkCameraSupport();
      const hasAR = this.checkWebARSupport();

      if (!hasCamera || !hasAR) {
        this.showFallbackMode();
        return;
      }

      this.setupCamera();
    }

    async checkCameraSupport() {
      try {
        const devices = await navigator.mediaDevices.enumerateDevices();
        return devices.some(device => device.kind === 'videoinput');
      } catch (error) {
        console.log('Camera check failed:', error);
        return false;
      }
    }

    checkWebARSupport() {
      // Check for WebXR support
      return 'xr' in navigator && navigator.xr.isSessionSupported('immersive-ar');
    }

    showFallbackMode() {
      const fallbackContent = `
        <div class="fallback-mode bg-gray-100 rounded-lg p-8 text-center">
          <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z"/>
          </svg>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">{{ 'products.ar_try_on.ar_not_supported' | t }}</h3>
          <p class="text-gray-600 mb-4">{{ 'products.ar_try_on.ar_not_supported_desc' | t }}</p>
          <div class="alternative-options">
            <button class="view-360-btn px-6 py-2 bg-yellow-600 text-white rounded-lg hover:bg-yellow-700 transition-colors mb-2 block w-full">
              {{ 'products.ar_try_on.view_360_instead' | t }}
            </button>
            <button class="view-gallery-btn px-6 py-2 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400 transition-colors block w-full">
              {{ 'products.ar_try_on.view_product_gallery' | t }}
            </button>
          </div>
        </div>
      `;

      this.container.querySelector('.ar-display').innerHTML = fallbackContent;
    }

    async setupCamera() {
      try {
        const stream = await navigator.mediaDevices.getUserMedia({
          video: {
            facingMode: 'user',
            width: { ideal: 1280 },
            height: { ideal: 720 }
          }
        });

        this.cameraFeed.srcObject = stream;
        this.isActive = true;

        // Hide loading and show AR interface
        this.container.querySelector('.ar-loading').classList.add('hidden');
        this.startARProcessing();

      } catch (error) {
        console.log('Camera setup failed:', error);
        this.showCameraPermissionModal();
      }
    }

    showCameraPermissionModal() {
      const modal = this.container.querySelector('#camera-permission-modal');
      modal.classList.remove('hidden');
    }

    setupEventListeners() {
      // Camera permission
      this.container.querySelector('[data-action="allow-camera"]').addEventListener('click', () => {
        this.container.querySelector('#camera-permission-modal').classList.add('hidden');
        this.setupCamera();
      });

      this.container.querySelector('[data-action="deny-camera"]').addEventListener('click', () => {
        this.container.querySelector('#camera-permission-modal').classList.add('hidden');
        this.showFallbackMode();
      });

      // AR controls
      this.container.querySelector('[data-action="close-ar"]').addEventListener('click', () => {
        this.stopAR();
      });

      this.container.querySelector('[data-action="show-help"]').addEventListener('click', () => {
        this.showHelp();
      });

      this.container.querySelector('[data-action="show-settings"]').addEventListener('click', () => {
        this.toggleSettings();
      });

      this.container.querySelector('[data-action="zoom-in"]').addEventListener('click', () => {
        this.setARScale(this.arScale * 1.2);
      });

      this.container.querySelector('[data-action="zoom-out"]').addEventListener('click', () => {
        this.setARScale(this.arScale * 0.8);
      });

      this.container.querySelector('[data-action="reset-view"]').addEventListener('click', () => {
        this.resetARView();
      });

      this.container.querySelector('[data-action="rotate-product"]').addEventListener('click', () => {
        this.rotateARModel();
      });

      // Size and color selection
      this.container.querySelectorAll('.size-option').forEach(option => {
        option.addEventListener('click', () => {
          this.selectSize(option.dataset.size, option.dataset.variantId);
        });
      });

      this.container.querySelectorAll('.color-option').forEach(option => {
        option.addEventListener('click', () => {
          this.selectColor(option.dataset.color);
        });
      });

      // Capture and recording
      this.container.querySelector('[data-action="capture-photo"]').addEventListener('click', () => {
        this.capturePhoto();
      });

      this.container.querySelector('[data-action="toggle-recording"]').addEventListener('click', () => {
        this.toggleRecording();
      });

      this.container.querySelector('[data-action="share-ar"]').addEventListener('click', () => {
        this.shareARExperience();
      });

      // Settings
      document.getElementById('ar-quality').addEventListener('change', (e) => {
        this.settings.arQuality = e.target.value;
      });

      document.getElementById('lighting-mode').addEventListener('change', (e) => {
        this.settings.lightingMode = e.target.value;
      });

      document.getElementById('body-tracking-toggle').addEventListener('change', (e) => {
        this.settings.bodyTracking = e.target.checked;
      });

      document.getElementById('motion-stabilization-toggle').addEventListener('change', (e) => {
        this.settings.motionStabilization = e.target.checked;
      });

      document.getElementById('ar-model-type').addEventListener('change', (e) => {
        this.settings.arModelType = e.target.value;
      });

      document.getElementById('measurements-toggle').addEventListener('change', (e) => {
        this.settings.showMeasurements = e.target.checked;
      });

      // Settings actions
      this.container.querySelector('[data-action="save-settings"]').addEventListener('click', () => {
        this.saveSettings();
      });

      this.container.querySelector('[data-action="reset-settings"]').addEventListener('click', () => {
        this.resetSettings();
      });

      this.container.querySelector('[data-action="close-settings"]').addEventListener('click', () => {
        this.toggleSettings();
      });

      // Touch gestures for AR model manipulation
      this.setupTouchGestures();

      // Keyboard shortcuts
      document.addEventListener('keydown', (e) => {
        if (this.isActive) {
          switch(e.key) {
            case 'Escape':
              this.stopAR();
              break;
            case ' ':
              e.preventDefault();
              this.capturePhoto();
              break;
            case '+':
            case '=':
              this.setARScale(this.arScale * 1.2);
              break;
            case '-':
              this.setARScale(this.arScale * 0.8);
              break;
          }
        }
      });
    }

    setupTouchGestures() {
      let touchStartDistance = 0;
      let touchStartAngle = 0;

      const getDistance = (touch1, touch2) => {
        const dx = touch1.clientX - touch2.clientX;
        const dy = touch1.clientY - touch2.clientY;
        return Math.sqrt(dx * dx + dy * dy);
      };

      const getAngle = (touch1, touch2) => {
        const dx = touch2.clientX - touch1.clientX;
        const dy = touch2.clientY - touch1.clientY;
        return Math.atan2(dy, dx);
      };

      this.arCanvas.addEventListener('touchstart', (e) => {
        if (e.touches.length === 2) {
          touchStartDistance = getDistance(e.touches[0], e.touches[1]);
          touchStartAngle = getAngle(e.touches[0], e.touches[1]);
        }
      });

      this.arCanvas.addEventListener('touchmove', (e) => {
        if (e.touches.length === 2) {
          e.preventDefault();
          const currentDistance = getDistance(e.touches[0], e.touches[1]);
          const currentAngle = getAngle(e.touches[0], e.touches[1]);

          // Pinch to zoom
          const scale = currentDistance / touchStartDistance;
          this.setARScale(this.arScale * scale);

          // Rotate
          const angleDiff = currentAngle - touchStartAngle;
          this.arRotation += angleDiff;

          touchStartDistance = currentDistance;
          touchStartAngle = currentAngle;
        }
      });
    }

    startARProcessing() {
      this.updateARStatus('{{ 'products.ar_try_on.ar_active' | t }}', 'green');
      this.initializeARModel();
      this.animateAR();
    }

    initializeARModel() {
      // Create a placeholder AR model visualization
      const modelHTML = `
        <div class="ar-model" style="
          position: absolute;
          top: 50%;
          left: 50%;
          transform: translate(-50%, -50%) scale(${this.arScale}) rotate(${this.arRotation}deg);
          width: 200px;
          height: 300px;
          background: linear-gradient(135deg, #d4af37, #6a1b1b);
          border-radius: 20px;
          box-shadow: 0 10px 30px rgba(0,0,0,0.3);
          display: flex;
          align-items: center;
          justify-content: center;
          color: white;
          font-size: 1.2rem;
          font-weight: bold;
          text-align: center;
          transition: all 0.3s ease;
        ">
          AR Product Model
        </div>
      `;

      this.arModelContainer.innerHTML = modelHTML;
    }

    animateAR() {
      if (!this.isActive) return;

      // Clear canvas
      this.ctx.clearRect(0, 0, this.arCanvas.width, this.arCanvas.height);

      // Draw AR overlay elements
      this.drawAROverlay();

      // Update AR model
      this.updateARModel();

      // Continue animation
      requestAnimationFrame(() => this.animateAR());
    }

    drawAROverlay() {
      // Draw AR guides and indicators
      if (this.settings.showMeasurements) {
        this.drawMeasurements();
      }

      // Draw body tracking points (simulated)
      if (this.settings.bodyTracking) {
        this.drawBodyTracking();
      }
    }

    drawMeasurements() {
      this.ctx.strokeStyle = '#d4af37';
      this.ctx.lineWidth = 2;
      this.ctx.setLineDash([5, 5]);

      // Draw measurement lines
      const centerX = this.arCanvas.width / (2 * window.devicePixelRatio);
      const centerY = this.arCanvas.height / (2 * window.devicePixelRatio);

      // Height measurement
      this.ctx.beginPath();
      this.ctx.moveTo(centerX - 50, centerY - 100);
      this.ctx.lineTo(centerX + 50, centerY - 100);
      this.ctx.stroke();

      // Width measurement
      this.ctx.beginPath();
      this.ctx.moveTo(centerX - 75, centerY);
      this.ctx.lineTo(centerX + 75, centerY);
      this.ctx.stroke();

      this.ctx.setLineDash([]);
    }

    drawBodyTracking() {
      // Simulate body tracking points
      this.ctx.fillStyle = '#d4af37';
      const points = [
        { x: 0.3, y: 0.3 }, // Left shoulder
        { x: 0.7, y: 0.3 }, // Right shoulder
        { x: 0.5, y: 0.5 }, // Center
        { x: 0.4, y: 0.7 }, // Left hip
        { x: 0.6, y: 0.7 }  // Right hip
      ];

      points.forEach(point => {
        const x = point.x * (this.arCanvas.width / window.devicePixelRatio);
        const y = point.y * (this.arCanvas.height / window.devicePixelRatio);

        this.ctx.beginPath();
        this.ctx.arc(x, y, 5, 0, 2 * Math.PI);
        this.ctx.fill();
      });
    }

    updateARModel() {
      const model = this.arModelContainer.querySelector('.ar-model');
      if (model) {
        model.style.transform = `translate(-50%, -50%) scale(${this.arScale}) rotate(${this.arRotation}deg)`;
      }
    }

    setARScale(scale) {
      this.arScale = Math.max(0.5, Math.min(3, scale));
      this.updateARModel();
    }

    rotateARModel() {
      this.arRotation += 45;
      this.updateARModel();
    }

    resetARView() {
      this.arScale = 1;
      this.arRotation = 0;
      this.updateARModel();
    }

    selectSize(size, variantId) {
      this.currentSize = size;

      // Update UI
      this.container.querySelectorAll('.size-option').forEach(option => {
        option.classList.toggle('active', option.dataset.size === size);
      });

      // Update AR model
      this.updateARModelForVariant();
    }

    selectColor(color) {
      this.currentColor = color;

      // Update UI
      this.container.querySelectorAll('.color-option').forEach(option => {
        option.classList.toggle('active', option.dataset.color === color);
      });

      // Update AR model
      this.updateARModelForVariant();
    }

    updateARModelForVariant() {
      const model = this.arModelContainer.querySelector('.ar-model');
      if (model) {
        // Update model based on selected size and color
        const colorMap = {
          'red': '#dc2626',
          'blue': '#2563eb',
          'green': '#16a34a',
          'yellow': '#d4af37',
          'black': '#1f2937',
          'white': '#f9fafb'
        };

        const color = colorMap[this.currentColor?.toLowerCase()] || '#d4af37';
        model.style.background = `linear-gradient(135deg, ${color}, #6a1b1b)`;
      }
    }

    capturePhoto() {
      if (!this.isActive) return;

      // Create a temporary canvas to capture the AR scene
      const captureCanvas = document.createElement('canvas');
      const captureCtx = captureCanvas.getContext('2d');
      const video = this.cameraFeed;

      captureCanvas.width = video.videoWidth;
      captureCanvas.height = video.videoHeight;

      // Draw the camera feed (mirrored)
      captureCtx.save();
      captureCtx.scale(-1, 1);
      captureCtx.drawImage(video, -captureCanvas.width, 0, captureCanvas.width, captureCanvas.height);
      captureCtx.restore();

      // Draw the AR model overlay
      const model = this.arModelContainer.querySelector('.ar-model');
      if (model) {
        const modelRect = model.getBoundingClientRect();
        const canvasRect = this.arCanvas.getBoundingClientRect();

        const scaleX = captureCanvas.width / canvasRect.width;
        const scaleY = captureCanvas.height / canvasRect.height;

        captureCtx.save();
        captureCtx.translate(
          (modelRect.left + modelRect.width / 2 - canvasRect.left) * scaleX,
          (modelRect.top + modelRect.height / 2 - canvasRect.top) * scaleY
        );
        captureCtx.scale(this.arScale, this.arScale);
        captureCtx.rotate((this.arRotation * Math.PI) / 180);

        // Draw simplified AR model
        captureCtx.fillStyle = '#d4af37';
        captureCtx.fillRect(-50, -75, 100, 150);

        captureCtx.restore();
      }

      // Convert to blob and save
      captureCanvas.toBlob((blob) => {
        const url = URL.createObjectURL(blob);
        const photo = {
          id: Date.now(),
          url: url,
          timestamp: new Date().toISOString(),
          size: this.currentSize,
          color: this.currentColor,
          productId: this.container.dataset.productId
        };

        this.capturedPhotos.unshift(photo);
        this.saveCapturedPhotos();
        this.displayCapturedPhoto(photo);
        this.showNotification('{{ 'products.ar_try_on.photo_captured' | t }}', 'success');
      }, 'image/jpeg', 0.9);
    }

    displayCapturedPhoto(photo) {
      const grid = this.container.querySelector('#captured-photos-grid');
      const photoElement = document.createElement('div');
      photoElement.className = 'captured-photo';
      photoElement.innerHTML = `
        <img src="${photo.url}" alt="AR Try-On">
        <div class="photo-overlay">
          <div>${photo.size || 'One Size'}</div>
          <div>${new Date(photo.timestamp).toLocaleDateString()}</div>
        </div>
      `;

      photoElement.addEventListener('click', () => {
        this.viewCapturedPhoto(photo);
      });

      grid.insertBefore(photoElement, grid.firstChild);
    }

    viewCapturedPhoto(photo) {
      const modal = document.createElement('div');
      modal.className = 'fixed inset-0 bg-black bg-opacity-80 flex items-center justify-center z-50';
      modal.innerHTML = `
        <div class="max-w-4xl max-h-[90vh] mx-4">
          <img src="${photo.url}" alt="AR Try-On" class="max-w-full max-h-full rounded-lg">
          <div class="text-center mt-4">
            <p class="text-white mb-2">Size: ${photo.size || 'One Size'} | Color: ${photo.color || 'Default'}</p>
            <button class="px-6 py-2 bg-yellow-600 text-white rounded-lg hover:bg-yellow-700 transition-colors" onclick="this.closest('.fixed').remove()">
              Close
            </button>
          </div>
        </div>
      `;
      document.body.appendChild(modal);
    }

    async toggleRecording() {
      if (!this.isActive) return;

      if (this.isRecording) {
        this.stopRecording();
      } else {
        this.startRecording();
      }
    }

    async startRecording() {
      try {
        const stream = await navigator.mediaDevices.getDisplayMedia({
          video: { mediaSource: 'screen' }
        });

        this.mediaRecorder = new MediaRecorder(stream);
        this.recordedChunks = [];

        this.mediaRecorder.ondataavailable = (event) => {
          if (event.data.size > 0) {
            this.recordedChunks.push(event.data);
          }
        };

        this.mediaRecorder.onstop = () => {
          this.saveRecording();
        };

        this.mediaRecorder.start();
        this.isRecording = true;
        this.updateRecordingButton();

        // Add recording indicator
        const indicator = document.createElement('div');
        indicator.className = 'recording-indicator';
        indicator.innerHTML = `
          <div class="recording-dot w-3 h-3 bg-white rounded-full animate-pulse"></div>
          Recording...
        `;
        this.container.querySelector('.ar-display').appendChild(indicator);

      } catch (error) {
        console.log('Recording failed:', error);
        this.showNotification('{{ 'products.ar_try_on.recording_failed' | t }}', 'error');
      }
    }

    stopRecording() {
      if (this.mediaRecorder && this.isRecording) {
        this.mediaRecorder.stop();
        this.isRecording = false;
        this.updateRecordingButton();

        // Remove recording indicator
        const indicator = this.container.querySelector('.recording-indicator');
        if (indicator) {
          indicator.remove();
        }
      }
    }

    saveRecording() {
      const blob = new Blob(this.recordedChunks, { type: 'video/webm' });
      const url = URL.createObjectURL(blob);

      // Create download link
      const a = document.createElement('a');
      a.href = url;
      a.download = `ar-try-on-${Date.now()}.webm`;
      a.click();

      this.showNotification('{{ 'products.ar_try_on.recording_saved' | t }}', 'success');
    }

    updateRecordingButton() {
      const btn = this.container.querySelector('[data-action="toggle-recording"]');
      const icon = btn.querySelector('svg');
      const text = btn.querySelector('span') || btn.childNodes[btn.childNodes.length - 1];

      if (this.isRecording) {
        btn.classList.remove('bg-red-600', 'hover:bg-red-700');
        btn.classList.add('bg-gray-600', 'hover:bg-gray-700');
        icon.innerHTML = '<rect x="6" y="4" width="8" height="12"/>';
        if (text.nodeType === Node.TEXT_NODE) {
          text.textContent = ' {{ 'products.ar_try_on.stop_recording' | t }}';
        }
      } else {
        btn.classList.remove('bg-gray-600', 'hover:bg-gray-700');
        btn.classList.add('bg-red-600', 'hover:bg-red-700');
        icon.innerHTML = '<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM7 9a1 1 0 000 2h6a1 1 0 100-2H7z"/>';
        if (text.nodeType === Node.TEXT_NODE) {
          text.textContent = ' {{ 'products.ar_try_on.record_video' | t }}';
        }
      }
    }

    shareARExperience() {
      if (navigator.share) {
        navigator.share({
          title: '{{ product.title }} - AR Try-On',
          text: 'Check out this amazing AR try-on experience!',
          url: window.location.href
        }).catch(() => {
          // Share cancelled
        });
      } else {
        // Fallback: copy to clipboard
        navigator.clipboard.writeText(window.location.href).then(() => {
          this.showNotification('{{ 'products.ar_try_on.link_copied' | t }}', 'success');
        });
      }
    }

    toggleSettings() {
      const panel = this.container.querySelector('#ar-settings-panel');
      panel.classList.toggle('hidden');
    }

    showHelp() {
      const helpModal = document.createElement('div');
      helpModal.className = 'fixed inset-0 bg-black bg-opacity-80 flex items-center justify-center z-50';
      helpModal.innerHTML = `
        <div class="bg-white rounded-lg p-6 max-w-md mx-4">
          <h3 class="text-xl font-semibold mb-4">{{ 'products.ar_try_on.ar_help' | t }}</h3>
          <div class="space-y-3 text-sm text-gray-600">
            <p><strong>{{ 'products.ar_try_on.zoom_help' | t }}:</strong> {{ 'products.ar_try_on.zoom_help_desc' | t }}</p>
            <p><strong>{{ 'products.ar_try_on.rotate_help' | t }}:</strong> {{ 'products.ar_try_on.rotate_help_desc' | t }}</p>
            <p><strong>{{ 'products.ar_try_on.capture_help' | t }}:</strong> {{ 'products.ar_try_on.capture_help_desc' | t }}</p>
            <p><strong>{{ 'products.ar_try_on.gestures_help' | t }}:</strong> {{ 'products.ar_try_on.gestures_help_desc' | t }}</p>
          </div>
          <button class="mt-6 px-6 py-2 bg-yellow-600 text-white rounded-lg hover:bg-yellow-700 transition-colors w-full" onclick="this.closest('.fixed').remove()">
            Got it!
          </button>
        </div>
      `;
      document.body.appendChild(helpModal);
    }

    updateARStatus(text, color = 'green') {
      const statusText = this.container.querySelector('#ar-status-text');
      const statusDot = this.container.querySelector('.status-dot');

      statusText.textContent = text;
      statusDot.className = `status-dot w-2 h-2 rounded-full animate-pulse bg-${color}-400`;
    }

    stopAR() {
      this.isActive = false;

      // Stop camera
      if (this.cameraFeed.srcObject) {
        this.cameraFeed.srcObject.getTracks().forEach(track => track.stop());
      }

      // Update status
      this.updateARStatus('{{ 'products.ar_try_on.ar_inactive' | t }}', 'red');

      // Show loading
      this.container.querySelector('.ar-loading').classList.remove('hidden');
      this.container.querySelector('.ar-loading').innerHTML = `
        <div class="text-center text-white">
          <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8 7a1 1 0 00-1 1v4a1 1 0 001 1h4a1 1 0 001-1V8a1 1 0 00-1-1H8z"/>
          </svg>
          <p class="text-lg">{{ 'products.ar_try_on.ar_stopped' | t }}</p>
          <button class="mt-4 px-6 py-2 bg-yellow-600 text-white rounded-lg hover:bg-yellow-700 transition-colors" onclick="location.reload()">
            {{ 'products.ar_try_on.restart_ar' | t }}
          </button>
        </div>
      `;
    }

    saveSettings() {
      localStorage.setItem('arTryOnSettings', JSON.stringify(this.settings));
      this.showNotification('{{ 'products.ar_try_on.settings_saved' | t }}', 'success');
    }

    loadSettings() {
      const saved = localStorage.getItem('arTryOnSettings');
      if (saved) {
        this.settings = { ...this.settings, ...JSON.parse(saved) };

        // Update UI
        document.getElementById('ar-quality').value = this.settings.arQuality;
        document.getElementById('lighting-mode').value = this.settings.lightingMode;
        document.getElementById('body-tracking-toggle').checked = this.settings.bodyTracking;
        document.getElementById('motion-stabilization-toggle').checked = this.settings.motionStabilization;
        document.getElementById('ar-model-type').value = this.settings.arModelType;
        document.getElementById('measurements-toggle').checked = this.settings.showMeasurements;
      }
    }

    resetSettings() {
      this.settings = {
        arQuality: 'medium',
        lightingMode: 'auto',
        bodyTracking: true,
        motionStabilization: true,
        arModelType: 'standard',
        showMeasurements: false
      };

      // Update UI
      document.getElementById('ar-quality').value = this.settings.arQuality;
      document.getElementById('lighting-mode').value = this.settings.lightingMode;
      document.getElementById('body-tracking-toggle').checked = this.settings.bodyTracking;
      document.getElementById('motion-stabilization-toggle').checked = this.settings.motionStabilization;
      document.getElementById('ar-model-type').value = this.settings.arModelType;
      document.getElementById('measurements-toggle').checked = this.settings.showMeasurements;

      this.showNotification('{{ 'products.ar_try_on.settings_reset' | t }}', 'info');
    }

    saveCapturedPhotos() {
      localStorage.setItem('arTryOnPhotos', JSON.stringify(this.capturedPhotos.slice(0, 20))); // Keep last 20 photos
    }

    loadCapturedPhotos() {
      const saved = localStorage.getItem('arTryOnPhotos');
      if (saved) {
        this.capturedPhotos = JSON.parse(saved);
        this.capturedPhotos.forEach(photo => {
          this.displayCapturedPhoto(photo);
        });
      }
    }

    showNotification(message, type = 'info') {
      const notification = document.createElement('div');
      notification.className = `fixed top-4 right-4 px-6 py-3 rounded-lg text-white z-50 transition-all transform translate-x-full`;

      switch(type) {
        case 'success':
          notification.classList.add('bg-green-500');
          break;
        case 'error':
          notification.classList.add('bg-red-500');
          break;
        default:
          notification.classList.add('bg-blue-500');
      }

      notification.textContent = message;
      document.body.appendChild(notification);

      setTimeout(() => {
        notification.classList.remove('translate-x-full');
      }, 100);

      setTimeout(() => {
        notification.classList.add('translate-x-full');
        setTimeout(() => {
          document.body.removeChild(notification);
        }, 300);
      }, 3000);
    }
  }

  // Initialize AR Try-On
  const arContainers = document.querySelectorAll('.ar-try-on');
  arContainers.forEach(container => {
    new ARTryOn(container);
  });

  // Make available globally for Shopify integration
  window.theme = window.theme || {};
  window.theme.arTryOn = ARTryOn;
});
</script>