          <!-- Saree -->
          <div class="traditional-item bg-white rounded-lg shadow-lg overflow-hidden">
            <div class="item-image h-48 bg-gradient-to-br from-red-600 to-pink-600 flex items-center justify-center">
              <span class="text-6xl">👘</span>
            </div>
            <div class="p-6">
              <h5 class="text-xl font-semibold mb-2" data-i18n="cultural_guide.saree">Saree (சேலை)</h5>
              <p class="text-gray-600 text-sm mb-3" data-i18n="cultural_guide.saree_desc">
                The quintessential Tamil garment, typically 6-9 yards of unstitched fabric draped elegantly around the body.
              </p>
