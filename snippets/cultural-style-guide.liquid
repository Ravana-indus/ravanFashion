            <p class="text-sm text-gray-600" data-i18n="cultural_guide.zari_desc">
              Gold and silver thread embroidery
            </p>
          </div>
        </div>

        <!-- Weaving Techniques -->
        <div class="grid lg:grid-cols-2 gap-8">
          <div class="techniques-section">
            <h5 class="text-xl font-semibold mb-4" data-i18n="cultural_guide.weaving_techniques">Traditional Weaving Techniques</h5>
            <div class="space-y-4">
              <div class="technique-item bg-gray-50 rounded-lg p-4">
                <h6 class="font-medium mb-2" data-i18n="cultural_guide.handloom">Handloom Weaving</h6>
                <p class="text-sm text-gray-600" data-i18n="cultural_guide.handloom_desc">
                  Traditional looms operated by hand, creating unique textures and patterns passed down through generations.
                </p>
              </div>
              <div class="technique-item bg-gray-50 rounded-lg p-4">
                <h6 class="font-medium mb-2" data-i18n="cultural_guide.jamdani">Jamdani Technique</h6>
                <p class="text-sm text-gray-600" data-i18n="cultural_guide.jamdani_desc">
                  Intricate supplementary weft patterns woven directly into the fabric, creating elaborate motifs.
                </p>
              </div>
              <div class="technique-item bg-gray-50 rounded-lg p-4">
                <h6 class="font-medium mb-2" data-i18n="cultural_guide.ikat">Ikat Dyeing</h6>
                <p class="text-sm text-gray-600" data-i18n="cultural_guide.ikat_desc">
                  Resist dyeing technique where threads are dyed before weaving, creating distinctive blurred patterns.
                </p>
              </div>
            </div>
          </div>

