              <span class="text-6xl">👔</span>
            </div>
            <div class="p-6">
              <h5 class="text-xl font-semibold mb-2" data-i18n="cultural_guide.veshti">Veshti (வேஷ்டி)</h5>
              <p class="text-gray-600 text-sm mb-3" data-i18n="cultural_guide.veshti_desc">
