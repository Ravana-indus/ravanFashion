Cultural Style Guide - Tamil fashion education section
Educational content about Tamil fashion, traditions, and modern adaptations
{%- endcomment -%}

<div class="cultural-style-guide" data-guide-id="tamil-fashion-guide">
  <!-- Guide Header -->
  <div class="guide-header text-center mb-12">
    <div class="guide-icon mb-6">
      <div class="w-24 h-24 mx-auto rounded-full bg-gradient-to-br from-amber-600 to-orange-600 flex items-center justify-center text-white text-4xl">
        <svg class="w-12 h-12" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M3 5a2 2 0 012-2h10a2 2 0 012 2v8a2 2 0 01-2 2h-2.22l.123.489.804.804A1 1 0 0115 15H5a1 1 0 01-.707-1.707l.804-.804L5.22 13H5a2 2 0 01-2-2V5zm5.771 7H5V5h10v7H8.771z" clip-rule="evenodd"/>
        </svg>
      </div>
    </div>
    <h3 class="text-3xl font-bold text-gray-800 mb-3" data-i18n="cultural_guide.title">Tamil Fashion Heritage Guide</h3>
    <p class="text-lg text-gray-600 max-w-3xl mx-auto" data-i18n="cultural_guide.subtitle">
      Discover the rich traditions of Tamil fashion and how they influence contemporary style
    </p>
  </div>

  <!-- Navigation Tabs -->
  <div class="guide-navigation max-w-4xl mx-auto mb-8">
    <div class="flex flex-wrap justify-center gap-2" role="tablist">
      <button class="tab-btn active bg-amber-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-amber-700 transition-colors"
              data-tab="history" role="tab" aria-selected="true">
        <span data-i18n="cultural_guide.history">History</span>
      </button>
      <button class="tab-btn bg-gray-200 text-gray-700 px-6 py-3 rounded-lg font-medium hover:bg-gray-300 transition-colors"
              data-tab="traditional" role="tab" aria-selected="false">
        <span data-i18n="cultural_guide.traditional">Traditional Wear</span>
      </button>
      <button class="tab-btn bg-gray-200 text-gray-700 px-6 py-3 rounded-lg font-medium hover:bg-gray-300 transition-colors"
              data-tab="fabrics" role="tab" aria-selected="false">
        <span data-i18n="cultural_guide.fabrics">Fabrics & Crafts</span>
      </button>
      <button class="tab-btn bg-gray-200 text-gray-700 px-6 py-3 rounded-lg font-medium hover:bg-gray-300 transition-colors"
              data-tab="modern" role="tab" aria-selected="false">
        <span data-i18n="cultural_guide.modern">Modern Fusion</span>
      </button>
      <button class="tab-btn bg-gray-200 text-gray-700 px-6 py-3 rounded-lg font-medium hover:bg-gray-300 transition-colors"
              data-tab="occasions" role="tab" aria-selected="false">
        <span data-i18n="cultural_guide.occasions">Occasions</span>
      </button>
      <button class="tab-btn bg-gray-200 text-gray-700 px-6 py-3 rounded-lg font-medium hover:bg-gray-300 transition-colors"
              data-tab="jewelry" role="tab" aria-selected="false">
        <span data-i18n="cultural_guide.jewelry">Jewelry</span>
      </button>
    </div>
  </div>

  <!-- Content Sections -->
  <div class="guide-content max-w-6xl mx-auto">
    <!-- History Section -->
    <div id="history-section" class="content-section active" role="tabpanel">
      <div class="grid lg:grid-cols-2 gap-8 items-center mb-12">
        <div>
          <h4 class="text-2xl font-bold text-gray-800 mb-4" data-i18n="cultural_guide.history_title">Ancient Origins</h4>
          <p class="text-gray-600 mb-4" data-i18n="cultural_guide.history_desc1">
            Tamil fashion dates back over 2,000 years, with roots in the ancient Sangam period. Traditional clothing was designed for the tropical climate while maintaining cultural modesty and elegance.
          </p>
          <p class="text-gray-600 mb-4" data-i18n="cultural_guide.history_desc2">
            The ancient Tamil people were master weavers and dyers, creating exquisite textiles that were traded throughout the ancient world. References to fine clothing appear in Sangam literature, describing garments made of cotton, silk, and gold thread.
          </p>
          <div class="key-points bg-amber-50 rounded-lg p-4">
            <h5 class="font-semibold mb-2 flex items-center gap-2">
              <svg class="w-5 h-5 text-amber-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span data-i18n="cultural_guide.key_points">Key Historical Points</span>
            </h5>
            <ul class="space-y-1 text-sm text-gray-700">
              <li>• <span data-i18n="cultural_guide.history_point1">Sangam literature (300 BCE - 300 CE) describes elaborate clothing</span></li>
              <li>• <span data-i18n="cultural_guide.history_point2">Ancient port cities traded textiles with Rome and China</span></li>
              <li>• <span data-i18n="cultural_guide.history_point3">Traditional weaving techniques preserved for generations</span></li>
              <li>• <span data-i18n="cultural_guide.history_point4">Clothing reflected social status and occupation</span></li>
            </ul>
          </div>
        </div>
        <div class="history-timeline">
          <div class="bg-white rounded-lg shadow-lg p-6">
            <h5 class="font-semibold mb-4" data-i18n="cultural_guide.timeline">Evolution Timeline</h5>
            <div class="space-y-4">
              <div class="timeline-item">
                <div class="font-semibold text-amber-600">Sangam Period</div>
                <div class="text-sm text-gray-600">300 BCE - 300 CE</div>
                <div class="text-sm text-gray-700" data-i18n="cultural_guide.sangam_period">First references to woven garments and jewelry</div>
              </div>
              <div class="timeline-item">
                <div class="font-semibold text-amber-600">Medieval Era</div>
                <div class="text-sm text-gray-600">600 - 1300 CE</div>
                <div class="text-sm text-gray-700" data-i18n="cultural_guide.medieval_era">Flourishing of temple arts and traditional crafts</div>
              </div>
              <div class="timeline-item">
                <div class="font-semibold text-amber-600">Colonial Period</div>
                <div class="text-sm text-gray-600">1600 - 1947</div>
                <div class="text-sm text-gray-700" data-i18n="cultural_guide.colonial_period">Fusion of indigenous and foreign influences</div>
              </div>
              <div class="timeline-item">
                <div class="font-semibold text-amber-600">Modern Era</div>
                <div class="text-sm text-gray-600">1947 - Present</div>
                <div class="text-sm text-gray-700" data-i18n="cultural_guide.modern_era">Revival and innovation in traditional fashion</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Traditional Wear Section -->
    <div id="traditional-section" class="content-section hidden" role="tabpanel">
      <div class="mb-8">
        <h4 class="text-2xl font-bold text-gray-800 mb-6" data-i18n="cultural_guide.traditional_title">Traditional Tamil Attire</h4>

