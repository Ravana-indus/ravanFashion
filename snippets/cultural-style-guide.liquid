            <div>
              <h6 class="font-medium mb-2" data-i18n="cultural_guide.madurai">Madurai</h6>
              <p class="text-sm text-gray-600" data-i18n="cultural_guide.madurai_desc">
                Traditional Sungudi sarees with tie-dye patterns and temple motifs.
              </p>
            </div>
            <div>
              <h6 class="font-medium mb-2" data-i18n="cultural_guide.tanjore">Tanjore</h6>
              <p class="text-sm text-gray-600" data-i18n="cultural_guide.tanjore_desc">
                Rich silk sarees with gold zari work and temple jewelry traditions.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Fabrics & Crafts Section -->
