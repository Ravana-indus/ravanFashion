        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
          <div class="fabric-card bg-white rounded-lg shadow-lg p-6 text-center">
            <div class="fabric-icon w-16 h-16 mx-auto mb-4 bg-red-100 rounded-full flex items-center justify-center text-2xl">
