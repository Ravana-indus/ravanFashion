              <span class="text-6xl">👗</span>
            </div>
            <div class="p-6">
              <h5 class="text-xl font-semibold mb-2" data-i18n="cultural_guide.half_saree">Half Saree (பாவாடை சட்டை)</h5>
              <p class="text-gray-600 text-sm mb-3" data-i18n="cultural_guide.half_saree_desc">
                Traditional attire for young women, consisting of a long skirt, blouse, and dupatta.
              </p>
              <div class="space-y-2">
                <div class="flex items-center gap-2 text-sm">
                  <svg class="w-4 h-4 text-amber-600" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                  <span data-i18n="cultural_guide.transitional">Transitional garment</span>
                </div>
                <div class="flex items-center gap-2 text-sm">
                  <svg class="w-4 h-4 text-amber-600" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                  <span data-i18n="cultural_guide.vibrant_colors">Vibrant colors and patterns</span>
                </div>
                <div class="flex items-center gap-2 text-sm">
                  <svg class="w-4 h-4 text-amber-600" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
