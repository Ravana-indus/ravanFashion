<script>
class CulturalStyleGuide {
  constructor(container) {
    this.container = container;
    this.currentTab = 'history';

    this.init();
  }

  init() {
    this.setupEventListeners();
    this.loadContent();
  }

  setupEventListeners() {
    // Tab navigation
    this.container.querySelectorAll('.tab-btn').forEach(btn => {
      btn.addEventListener('click', (e) => this.switchTab(e.target.dataset.tab));
    });

    // Keyboard navigation
    this.container.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') {
        this.navigateWithKeyboard(e.key);
      }
    });
  }

  switchTab(tabId) {
    // Hide all sections
    this.container.querySelectorAll('.content-section').forEach(section => {
      section.classList.add('hidden');
      section.setAttribute('aria-hidden', 'true');
    });

    // Show selected section
    const targetSection = document.getElementById(`${tabId}-section`);
    if (targetSection) {
      targetSection.classList.remove('hidden');
      targetSection.setAttribute('aria-hidden', 'false');
    }

    // Update tab buttons
    this.container.querySelectorAll('.tab-btn').forEach(btn => {
      btn.classList.remove('active', 'bg-amber-600', 'text-white');
      btn.classList.add('bg-gray-200', 'text-gray-700');
      btn.setAttribute('aria-selected', 'false');
    });

    const activeBtn = this.container.querySelector(`[data-tab="${tabId}"]`);
    if (activeBtn) {
      activeBtn.classList.add('active', 'bg-amber-600', 'text-white');
      activeBtn.classList.remove('bg-gray-200', 'text-gray-700');
      activeBtn.setAttribute('aria-selected', 'true');
    }

    this.currentTab = tabId;

    // Track user engagement
    this.trackTabView(tabId);
  }

  navigateWithKeyboard(direction) {
    const tabs = Array.from(this.container.querySelectorAll('.tab-btn'));
    const currentIndex = tabs.findIndex(tab => tab.dataset.tab === this.currentTab);

    let newIndex;
    if (direction === 'ArrowLeft') {
      newIndex = currentIndex > 0 ? currentIndex - 1 : tabs.length - 1;
    } else {
      newIndex = currentIndex < tabs.length - 1 ? currentIndex + 1 : 0;
    }

    if (tabs[newIndex]) {
      tabs[newIndex].click();
      tabs[newIndex].focus();
    }
  }

  loadContent() {
    // Lazy load images or additional content if needed
    this.prefetchContent();
  }

  prefetchContent() {
    // Prefetch content for better performance
    const sections = ['traditional', 'fabrics', 'modern', 'occasions', 'jewelry'];

    sections.forEach(section => {
      if (section !== this.currentTab) {
        // Prefetch images or data for this section
        this.prefetchSection(section);
      }
    });
  }

  prefetchSection(sectionId) {
    // Implement prefetching logic based on section needs
    // This could preload images, fetch additional data, etc.
  }

  trackTabView(tabId) {
    // Track user engagement for analytics
    if (typeof gtag !== 'undefined') {
      gtag('event', 'tab_view', {
        'event_category': 'cultural_style_guide',
        'event_label': tabId
      });
    }

    // Save to localStorage for personalization
    this.saveUserPreference(tabId);
  }

  saveUserPreference(tabId) {
    const preferences = JSON.parse(localStorage.getItem('cultural-guide-preferences') || '{}');
    preferences.lastViewedTab = tabId;
    preferences.viewCount = (preferences.viewCount || {});
    preferences.viewCount[tabId] = (preferences.viewCount[tabId] || 0) + 1;
    localStorage.setItem('cultural-guide-preferences', JSON.stringify(preferences));
  }

  getUserProgress() {
    const preferences = JSON.parse(localStorage.getItem('cultural-guide-preferences') || '{}');
    return {
      lastViewedTab: preferences.lastViewedTab || 'history',
      viewCount: preferences.viewCount || {},
      completedSections: this.getCompletedSections()
    };
  }

  getCompletedSections() {
    // Determine which sections the user has completed
    // This could be based on scroll depth, time spent, etc.
    return [];
  }

  // Public methods for integration with other components
  scrollToSection(sectionId) {
    this.switchTab(sectionId);
    const section = document.getElementById(`${sectionId}-section`);
    if (section) {
      section.scrollIntoView({ behavior: 'smooth' });
    }
  }

  getRecommendations() {
    // Get personalized recommendations based on user behavior
    const progress = this.getUserProgress();
    const recommendations = [];

    // Recommend sections based on viewing patterns
    if (progress.viewCount['history'] > 2) {
      recommendations.push('traditional');
    }

    if (progress.viewCount['traditional'] > 1) {
      recommendations.push('jewelry');
    }

    return recommendations;
  }
}

