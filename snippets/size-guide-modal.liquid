<script>
  // Size Guide Modal System
  window.theme = window.theme || {};

  window.theme.openSizeGuide = function() {
    const modal = document.getElementById('size-guide-modal');
    modal.classList.add('active');
    document.body.style.overflow = 'hidden';
  };

  window.theme.closeSizeGuide = function() {
    const modal = document.getElementById('size-guide-modal');
    modal.classList.remove('active');
    document.body.style.overflow = '';
  };

  window.theme.showSizeTab = function(tabName) {
    // Hide all tabs
    document.querySelectorAll('.size-tab-content').forEach(tab => {
      tab.classList.remove('active');
    });

    // Remove active class from all tab buttons
    document.querySelectorAll('.size-tab').forEach(tab => {
      tab.classList.remove('active');
    });

    // Show selected tab
    document.getElementById(`${tabName}-tab`).classList.add('active');

    // Add active class to clicked tab button
    event.target.classList.add('active');
  };

  window.theme.selectFit = function(fitType) {
    // Remove selected class from all fit options
    document.querySelectorAll('.fit-option').forEach(option => {
      option.classList.remove('selected');
    });

    // Add selected class to clicked option
    event.target.classList.add('selected');

    // Store preference
    localStorage.setItem('preferred-fit', fitType);
    console.log('Selected fit preference:', fitType);
  };

  window.theme.calculateSize = function() {
    const chest = parseFloat(document.getElementById('chest-input').value);
    const waist = parseFloat(document.getElementById('waist-input').value);

    if (!chest || !waist) {
      alert('{{ 'general.enter_both_measurements' | t }}');
      return;
    }

    let recommendedSize = '';
    const preferredFit = localStorage.getItem('preferred-fit') || 'regular';

    // Simple size calculation based on chest measurement
    if (chest < 88) {
      recommendedSize = 'XS';
    } else if (chest < 92) {
      recommendedSize = 'S';
    } else if (chest < 96) {
      recommendedSize = 'M';
    } else if (chest < 100) {
      recommendedSize = 'L';
    } else if (chest < 104) {
      recommendedSize = 'XL';
    } else {
      recommendedSize = 'XXL';
    }

    // Adjust for fit preference
    if (preferredFit === 'tight' && recommendedSize !== 'XS') {
      const sizes = ['XS', 'S', 'M', 'L', 'XL', 'XXL'];
      const currentIndex = sizes.indexOf(recommendedSize);
      if (currentIndex > 0) {
        recommendedSize = sizes[currentIndex - 1];
      }
    } else if (preferredFit === 'loose' && recommendedSize !== 'XXL') {
      const sizes = ['XS', 'S', 'M', 'L', 'XL', 'XXL'];
      const currentIndex = sizes.indexOf(recommendedSize);
      if (currentIndex < sizes.length - 1) {
        recommendedSize = sizes[currentIndex + 1];
      }
    }

    // Show result
    document.getElementById('recommended-size').textContent = recommendedSize;
    document.getElementById('size-result').classList.remove('hidden');
  };

  // Close modal on background click
  document.getElementById('size-guide-modal').addEventListener('click', function(e) {
    if (e.target === this) {
      window.theme.closeSizeGuide();
    }
  });

  // Close modal on escape key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && document.getElementById('size-guide-modal').classList.contains('active')) {
      window.theme.closeSizeGuide();
    }
  });

  // Initialize fit preference from localStorage
  document.addEventListener('DOMContentLoaded', function() {
    const savedFit = localStorage.getItem('preferred-fit');
    if (savedFit) {
      document.querySelectorAll('.fit-option').forEach(option => {
        option.classList.remove('selected');
        if (option.textContent.toLowerCase().includes(savedFit)) {
          option.classList.add('selected');
        }
      });
    }
  });
</script>